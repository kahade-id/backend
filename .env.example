# ============================================================================
# KAHADE BACKEND — Environment Template
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust:   cp .env.example .env
#
# • Values below are safe DEVELOPMENT defaults; the app refuses to start in
#   production/staging when secrets are missing or look like placeholders
#   (see src/config/env.validation.ts).
# • Secrets must be generated with:  openssl rand -hex 32
#   (AES_SECRET_KEY / HMAC_SECRET_KEY / AES_KDF_SALT / WALLET_PIN_PEPPER and
#   all five JWT secrets require >= 64 hex chars in production.)
# • A full production walkthrough with hardened values lives in
#   DEPLOYMENT_GUIDE.md §6.3.
# ============================================================================

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=v1
APP_VERSION=1.0.0
# Public URL of this API (used in emails, deeplinks, webhooks)
APP_URL=http://localhost:3000
# Web app base URL (links in emails/notifications)
PUBLIC_WEB_BASE_URL=http://localhost:3001
# Log verbosity: error|warn|info|http|verbose|debug|silly (default: info in prod, debug in dev)
LOG_LEVEL=debug
# Comma-separated IP allowlist enabling Swagger /docs outside development
SWAGGER_ALLOWLIST=
# CORS allow-list, comma separated. NO wildcards/localhost in production.
CORS_ORIGINS=http://localhost:3001
# CIDR of trusted reverse proxy for correct client IPs (REQUIRED prod-like).
# Use "loopback" when running nginx on the same host.
TRUSTED_PROXY_CIDR=loopback
# Connect-src entries for the docs CSP (comma separated URLs)
CSP_CONNECT_SRC=

# ─── Database (PostgreSQL + Prisma) ─────────────────────────────────────────
# Pool params can be embedded here; otherwise the defaults below apply.
DATABASE_URL=postgresql://kahade:kahade@localhost:5432/kahade_db
DB_POOL_SIZE=5                     # default pool size (20 in production)
DB_POOL_TIMEOUT=10                 # seconds waiting for a pooled connection
DB_CONNECT_TIMEOUT=15              # seconds for initial TCP connect
DB_STATEMENT_TIMEOUT=30000         # ms per statement

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Separate Redis for Bull queues (can be the same instance)
BULL_REDIS_URL=redis://localhost:6379
# Key namespace — MUST differ between environments sharing one Redis
REDIS_PREFIX=kahade:dev:
BULL_EMAIL_CONCURRENCY=5
BULL_NOTIF_CONCURRENCY=5
# true = continue without Redis-backed security features when Redis is down.
# MUST be false in production/staging (startup aborts otherwise).
REDIS_AUTH_FAIL_OPEN=false

# ─── JWT secrets (openssl rand -hex 32; unique per key, per environment) ────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
JWT_ADMIN_REFRESH_SECRET=
JWT_TEMP_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=30m           # clamped to max 2h
JWT_ADMIN_REFRESH_EXPIRES_IN=7d
JWT_TEMP_EXPIRES_IN=5m
MAX_SESSIONS_PER_USER=5

# ─── Crypto / PII encryption (openssl rand -hex 32 → 64 chars) ──────────────
AES_SECRET_KEY=
HMAC_SECRET_KEY=
# 32-byte hex (64 chars) KDF salt for AES key derivation
AES_KDF_SALT=
# Optional dedicated keys for KYC fields (fallback: AES_SECRET_KEY)
KYC_NIK_ENCRYPTION_KEY=
KYC_KTP_ENCRYPTION_KEY=
KYC_SELFIE_ENCRYPTION_KEY=
# Set ONLY during key rotation; old data re-encrypts on next write
PREVIOUS_AES_SECRET_KEY=
WALLET_PIN_PEPPER=
BCRYPT_ROUNDS=12
BCRYPT_ROUNDS_ADMIN=14

# ─── OTP / auth flows ───────────────────────────────────────────────────────
# mock|fonnte|twilio — mock is fine for development, rejected in production
OTP_PROVIDER=mock
# Fonnte (WhatsApp)
FONNTE_API_TOKEN=
FONNTE_API_URL=https://api.fonnte.com
FONNTE_COUNTRY_CODE=62
# Twilio (SMS fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Returns the OTP in the API response — development ONLY, rejected in prod
OTP_DEBUG_RETURN_CODE=false
# 6–10 digit withdrawal confirmation OTPs
WITHDRAW_OTP_DIGITS=6
# Enable email+password auth alongside phone/username login
EMAIL_AUTH_ENABLED=true
WS_AUTH_TIMEOUT_MS=10000

# ─── Account lockout ────────────────────────────────────────────────────────
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
ACCOUNT_LOCK_MAX_CYCLES=5

# ─── Midtrans (payments + Iris disbursements) ───────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL=http://localhost:3000/v1/payments/midtrans-webhook
MIDTRANS_CALLBACK_URL=http://localhost:3001
# Comma-separated CIDRs allowed to call the webhook (REQUIRED prod-like)
MIDTRANS_ALLOWED_CIDRS=
# DANGER: bypass webhook IP allowlist — never in production
MIDTRANS_BYPASS_IP_CHECK=false
MIDTRANS_IRIS_KEY=
MIDTRANS_IRIS_IS_PRODUCTION=false
MIDTRANS_API_URL=https://api.sandbox.midtrans.com
MIDTRANS_IRIS_URL=https://app.sandbox.midtrans.com/iris
# Circuit breakers
MIDTRANS_CB_FAILURE_THRESHOLD=5
MIDTRANS_CB_RECOVERY_MS=30000
MIDTRANS_IRIS_CB_FAILURE_THRESHOLD=5
MIDTRANS_IRIS_CB_RECOVERY_MS=30000

# ─── Payment channel fees (percentages / flat IDR, as charged by Midtrans) ──
PAYMENT_FEE_VA_BCA=4000
PAYMENT_FEE_VA_PERMATA=4000
PAYMENT_FEE_VA_MANDIRI=4000
PAYMENT_FEE_VA_BNI=4000
PAYMENT_FEE_VA_BRI=4000
PAYMENT_FEE_VA_CIMB=4000
PAYMENT_FEE_QRIS_PERCENT=0.7
PAYMENT_FEE_GOPAY_PERCENT=2
PAYMENT_FEE_SHOPEEPAY_PERCENT=2
PAYMENT_FEE_KREDIVO_PERCENT=2
PAYMENT_FEE_AKULAKU_PERCENT=2
PAYMENT_FEE_CREDIT_CARD_PERCENT=2.9
PAYMENT_FEE_CREDIT_CARD_FLAT=2000
PAYMENT_FEE_CSTORE_FLAT=5000

# ─── Cloudflare R2 (S3-compatible object storage) ───────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_PUBLIC=kahade-uploads-public
R2_BUCKET_PRIVATE=kahade-uploads-private
R2_PUBLIC_URL=http://localhost:3001/storage
R2_PRESIGN_EXPIRES=900

# ─── Upload size caps (MB) ──────────────────────────────────────────────────
UPLOAD_MAX_AVATAR_MB=2
UPLOAD_MAX_CHAT_MB=10
UPLOAD_MAX_KYC_MB=5
UPLOAD_MAX_EVIDENCE_MB=10

# ─── SMTP (email) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kahade <noreply@kahade.id>

# ─── Firebase Cloud Messaging (push notifications) ──────────────────────────
# All-or-nothing: leave empty to disable push.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Sentry (error tracking) ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Fees & escrow limits (IDR) ─────────────────────────────────────────────
# Percentages, e.g. 2.5 = 2.50%
KAHADE_FEE_RATE=2.5
KAHADE_PLUS_FEE_RATE=0.5
# Basis points cross-check (250 = 2.50%) — must match the percentage above
KAHADE_FEE_RATE_BPS=250
KAHADE_PLUS_FEE_RATE_BPS=50
ORDER_MIN_VALUE=10000
ORDER_MAX_VALUE=1000000000
FEE_SAVINGS_LIMIT=100000

# ─── Wallet limits (IDR) ────────────────────────────────────────────────────
WALLET_DAILY_TOPUP_LIMIT=50000000
WALLET_DAILY_WITHDRAW_LIMIT=50000000
WALLET_MIN_WITHDRAW=50000
TOPUP_EXPIRY_HOURS=24

# ─── Subscriptions (IDR / sen) ──────────────────────────────────────────────
SUBSCRIPTION_MONTHLY_PRICE=29000
SUBSCRIPTION_ANNUAL_PRICE=299000
SUBSCRIPTION_MONTHLY_PRICE_SEN=2900000
SUBSCRIPTION_ANNUAL_PRICE_SEN=29900000

# ─── Referrals & ratings ────────────────────────────────────────────────────
REFERRAL_REWARD_RATE_BPS=100
MAX_REFERRALS_PER_CODE=10
RATING_WINDOW_DAYS=7

# ─── Rate limiting / idempotency ────────────────────────────────────────────
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=100
ORDER_CREATE_RATE_LIMIT=5
ORDER_CREATE_RATE_WINDOW_SEC=60
# false = fail-closed 503 on money endpoints when Redis is down (REQUIRED prod)
IDEMPOTENCY_FAIL_OPEN=false
IDEMPOTENCY_TTL_SECONDS=86400

# ─── Exports ────────────────────────────────────────────────────────────────
# Wallet statement export window (days, 7–365)
EXPORT_MAX_DATE_RANGE_DAYS=90

# ─── Retention / cleanup jobs ───────────────────────────────────────────────
RETENTION_EXPIRED_OTP_DAYS=7
RETENTION_READ_NOTIFICATION_DAYS=30
RETENTION_UNREAD_NOTIFICATION_DAYS=90
RETENTION_WEBHOOK_LOG_DAYS=90
RETENTION_ANONYMIZE_DAYS=365
ORPHAN_UPLOAD_THRESHOLD_HOURS=48
ORPHAN_CLEANUP_ENABLED=true
WEBHOOK_RETRY_BATCH_SIZE=25
SHUTDOWN_TIMEOUT_MS=30000

# ─── Chat moderation ────────────────────────────────────────────────────────
# warn|mute|ban
CHAT_CIRCUMVENTION_ACTION=warn

# ─── Mobile app metadata (deep links / force-upgrade) ───────────────────────
DEEPLINK_BASE_URL=https://kahade.id/v1/deeplinks
UPDATE_CHECK_INTERVAL_MS=21600000
IOS_STORE_URL=
IOS_MINIMUM_VERSION=
IOS_LATEST_VERSION=
ANDROID_STORE_URL=
ANDROID_MINIMUM_VERSION=
ANDROID_LATEST_VERSION=
ANDROID_APPLICATION_ID=id.kahade.app
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=

# ─── Invoicing ──────────────────────────────────────────────────────────────
INVOICE_COMPANY_NAME=PT Kawal Hak Dengan Aman
INVOICE_COMPANY_ADDRESS=

# ─── Seed / ops scripts only (not read by the running app) ──────────────────
# prisma/seed.ts + scripts/backfill-pii-encryption.ts
SEED_PASSWORD=
SKIP_BANK_VERIFICATION=false
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
