# Replit configuration template.
#
# Copy this file to `.replit` (which is gitignored) when developing on Replit.
# Local development outside Replit doesn't need this file.

modules = ["nodejs-20"]
[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
