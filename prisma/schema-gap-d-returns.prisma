// ============================================================================
// GAP-D — Retur / tukar barang purnajual (G201–G225).
// File skema APPEND-ONLY untuk domain retur. DITULIS TERPISAH dari
// prisma/schema.prisma agar tidak mengganggu skema existing — koordinator
// menggabungkan file ini ke skema utama saat merge.
//
// KEPUTUSAN DESAIN:
// - ReturnRequest memakai status SENDIRI (ReturnStatus), bukan OrderStatus
//   dan bukan status sengketa (G202). Order tetap COMPLETED selama retur.
// - Uang: persetujuan refund (ReturnRefundApproval, idempotency key) TIDAK
//   memanggil provider (G210). Eksekusi memakai SATU jalur ledger internal
//   existing: debit dompet seller → kredit dompet buyer dengan
//   WalletTransactionType.ORDER_REFUND + guard versi/row-lock, meniru pola
//   post-completion mutual-resolution (disputes/mutual-resolution.service.ts).
//   Jalur provider Midtrans TIDAK dipakai untuk retur: (1) wrapper existing
//   `requestRefund` hanya mendukung full-amount, sedangkan retur butuh
//   parsial; (2) pasca-COMPLETED liabilitas ada di dompet seller — refund
//   via provider akan membayar dari kas platform tanpa clawback.
// - Cegah pengajuan ganda (G218): partial unique index di migration SQL
//   (orderId, COALESCE(itemRef,'')) untuk status non-terminal. Sengaja TIDAK
//   ditulis sebagai @@unique di sini karena Prisma tidak mendukung partial
//   index — lihat migration.sql.
// - Hal yang sama berlaku untuk kebijakan default (category IS NULL): satu
//   per orderType via partial unique index di migration.sql (PostgreSQL
//   menganggap NULL berbeda pada unique index biasa).
// - Kode TypeScript memakai union string lokal (returns.types.ts) hingga
//   client Prisma di-regenerate pasca-merge; nilai enum di sini adalah
//   sumber kebenaran.
//
// CATATAN MERGE UNTUK KOORDINATOR:
//  1. Tambahkan back-relation di model Order (schema.prisma):
//       returnRequests ReturnRequest[]
//     (relasi Prisma wajib dua sisi; tanpa ini `prisma validate` gagal).
//  2. Jalankan `prisma migrate deploy` untuk direktori
//     20260927040000_gap_d_returns (append-only; tidak menyentuh tabel existing).
//  3. Regenerate @prisma/client, lalu modul returns dapat beralih dari
//     facade returns.db.ts ke `this.prisma.returnRequest` langsung.
//  4. (Opsional, non-blocking) tambahkan nilai RETURN_* ke enum
//     NotificationType dan ganti RETURN_STAGE_NOTIFICATION_TYPE dengan nilai
//     sebenarnya; sampai saat itu notifikasi memakai tipe existing terdekat +
//     payload data.type='RETURN_*'.
// ============================================================================

// --- G202: status retur terpisah dari OrderStatus & sengketa ----------------
enum ReturnStatus {
  REQUESTED
  SELLER_REVIEW
  CLARIFICATION_NEEDED
  APPROVED
  REJECTED
  RETURN_SHIPPING
  RECEIVED
  RESOLVED_REFUND
  RESOLVED_EXCHANGE
  RESOLVED_REPAIR
  ESCALATED
  CANCELLED
  EXPIRED
}

// --- G204: alasan terstruktur pengajuan retur (buyer) -------------------------
enum ReturnReasonCode {
  BARANG_RUSAK
  BARANG_TIDAK_SESUAI_DESKRIPSI
  BARANG_TIDAK_LENGKAP
  BARANG_PALSU
  SALAH_KIRIM_VARIAN
  BARANG_KEDALUWARSA
  KEMASAN_RUSAK_PARAH
  LAINNYA
}

// --- G223: reason code penolakan konsisten (seller/admin) --------------------
enum ReturnRejectReasonCode {
  MELEWATI_BATAS_WAKTU
  BARANG_TIDAK_RUSAK
  KLAIM_TIDAK_VALID
  BUKTI_TIDAK_CUKUP
  BARANG_SUDAH_DIGUNAKAN
  KERUSAKAN_AKIBAT_PEMBELI
  DILUAR_CAKUPAN_KEBIJAKAN
  LAINNYA
}

// --- G209: opsi penyelesaian -------------------------------------------------
enum ReturnResolutionType {
  REFUND
  EXCHANGE
  REPAIR
  MUTUAL_AGREED
}

// --- G210: status persetujuan refund (idempoten) ------------------------------
enum RefundApprovalStatus {
  PENDING
  EXECUTING
  EXECUTED
  FAILED
}

enum ReturnActorType {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

// --- G201: kebijakan retur per tipe order & kategori --------------------------
model ReturnPolicy {
  id                 String    @id @default(cuid())
  orderType          OrderType // memakai enum existing (tanpa duplikasi)
  category           String?   // kategori barang; null = default semua kategori
  returnWindowDays   Int       @default(7) // G203: jendela pengajuan pasca COMPLETED
  sellerResponseHours Int      @default(72) // G208: SLA respons seller (jam)
  shipBackWindowDays Int       @default(7) // batas kirim balik pasca APPROVED
  clarificationWindowDays Int  @default(3) // batas jawab klarifikasi
  requireReturnShipment Boolean @default(true) // G215: terima barang dulu sblm kompensasi
  maxRefundBps       Int?      // pagu refund (basis poin dari buyerPayAmount); null = penuh
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([orderType, category])
  @@map("return_policies")
}

// --- Inti: pengajuan retur ----------------------------------------------------
model ReturnRequest {
  id               String       @id @default(cuid())
  returnId         String       @unique // format RTN-YYYYMMDD-XXXX (human readable)
  orderId          String       // FK ke Order.id (bukan orderId publik)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  itemRef          String?      // referensi item bila retur parsial; null = seluruh order
  buyerId          String
  sellerId         String
  status           ReturnStatus @default(REQUESTED)

  // G204 alasan terstruktur + deskripsi bebas
  reasonCode       ReturnReasonCode
  reasonDetail     String?      @db.Text

  // G209 opsi penyelesaian yang disepakati
  resolutionType   ReturnResolutionType?
  refundAmount     BigInt?      // nominal refund disetujui (sen); null utk non-refund

  // G207/G223 respons seller
  sellerRespondBy  DateTime?    // G208: deadline respons seller (dihitung server)
  rejectReasonCode ReturnRejectReasonCode?
  rejectNote       String?      @db.Text
  clarificationQuestion String? @db.Text

  // G212: instruksi kirim balik — HANYA diisi/ditampilkan setelah APPROVED
  returnInstructions String?    @db.Text
  shipBy             DateTime?  // batas kirim balik pasca APPROVED

  // G213: resi retur TERPISAH dari resi pengiriman awal
  returnTrackingNumber String?
  returnCourier        String?

  // G215 konfirmasi terima barang retur
  receivedAt       DateTime?
  receivedNote     String?      @db.Text

  // G217 eskalasi ke sengketa: LINK ke dispute existing, jangan buat baru
  disputeId        String?      // FK logis ke Dispute.id bila sudah ada case aktif

  approvedAt       DateTime?
  rejectedAt       DateTime?
  resolvedAt       DateTime?
  cancelledAt      DateTime?
  expiredAt        DateTime?
  escalatedAt      DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attachments      ReturnAttachment[]
  notes            ReturnNote[]
  timeline         ReturnTimeline[]
  shipmentEvents   ReturnShipmentEvent[]
  refundApproval   ReturnRefundApproval?

  // G218: partial unique index (status non-terminal) didefinisikan di migration.sql
  @@index([orderId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, sellerRespondBy])
  @@index([status, createdAt])
  @@map("return_requests")
}

// --- G205: foto kondisi + bukti (fileKey dari pipeline upload existing) -------
model ReturnAttachment {
  id              String   @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  fileKey         String   // dari POST /v1/upload/direct (purpose=return-evidence)
  fileName        String
  fileType        String
  fileSize        Int
  uploadedBy      String
  // G222: retensi bukti — scheduler menghapus fileKey setelah retainUntil
  retainUntil     DateTime?
  purgedAt        DateTime?
  createdAt       DateTime @default(now())

  @@index([returnRequestId])
  @@index([retainUntil])
  @@map("return_attachments")
}

// --- G216: negosiasi / catatan terlihat dua pihak -----------------------------
model ReturnNote {
  id              String          @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  authorId        String
  authorRole      ReturnActorType
  message         String          @db.Text
  visibleToBoth   Boolean         @default(true) // false = catatan internal admin
  createdAt       DateTime        @default(now())

  @@index([returnRequestId, createdAt])
  @@map("return_notes")
}

// --- G214/G220: timeline event purnajual + jejak audit append-only -----------
model ReturnTimeline {
  id              String          @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  event           String          // mis. STATUS_CHANGED, NOTE_ADDED, REFUND_APPROVED ...
  fromStatus      ReturnStatus?
  toStatus        ReturnStatus?
  actorId         String?
  actorRole       ReturnActorType @default(SYSTEM)
  metadata        Json?           // detail bebas (nominal, resi, alasan, dsb.)
  createdAt       DateTime        @default(now())

  @@index([returnRequestId, createdAt])
  @@map("return_timeline")
}

// --- G214: event tracking paket retur -----------------------------------------
model ReturnShipmentEvent {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  trackingNumber  String
  courier         String?
  status          String        // status kurir ternormalisasi (PICKED_UP, IN_TRANSIT, DELIVERED, ...)
  location        String?
  eventAt         DateTime      @default(now())
  rawPayload      Json?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId, eventAt])
  @@map("return_shipment_events")
}

// --- G210: persetujuan nominal refund — idempoten, TANPA panggil provider -----
model ReturnRefundApproval {
  id              String               @id @default(cuid())
  returnRequestId String               @unique
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  idempotencyKey  String               @unique // RTN-APPR-<returnId>; panggil 2x = 1 eksekusi
  amount          BigInt               // sen, ≤ buyerPayAmount (dan ≤ maxRefundBps bila ada)
  status          RefundApprovalStatus @default(PENDING)
  approvedBy      String               // sellerId / adminId penyetuju
  approvedByRole  ReturnActorType
  approvedAt      DateTime             @default(now())
  executedAt      DateTime?
  failureReason   String?              @db.Text
  walletTxIds     String[]             @default([]) // txId ledger ORDER_REFUND terkait
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("return_refund_approvals")
}
