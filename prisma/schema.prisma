// ============================================================
// USERS
// ============================================================

model User {
  id       String  @id @default(cuid())
  userId   String  @unique // Format: USR-XXXXXXXX
  username String? @unique
  email    String? @unique
  password String?

  // Profile
  fullName          String
  bio               String?         @db.VarChar(500)
  avatarUrl         String?
  headerUrl         String?
  accountType       UserAccountType @default(PERSONAL)
  usernameChangedAt DateTime?

  // Extended profile (collected at registration)
  phoneNumber      String            @unique
  phoneNumberHash  String?           @unique
  phoneVerified    Boolean           @default(false)
  // phoneVerifiedAt dibuat simetris dengan emailVerifiedAt: badge "Email & Phone
  // Verified" adalah kombinasi keduanya, jadi UI "Tentang" perlu tanggal kapan
  // masing-masing diverifikasi. Legacy rows (phoneVerified=true sebelum kolom ini
  // ada) tetap NULL — badge tetap tampil, earnedAt-nya fallback ke memberSince.
  phoneVerifiedAt  DateTime?
  authLocationLogs AuthLocationLog[]
  actionLocations  ActionLocation[]
  dateOfBirth      DateTime?         @db.Date
  gender           Gender?
  address          String?           @db.VarChar(500)

  // Verification
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // kycStatus denormalized — query cepat tanpa JOIN ke kyc_requests
  // Di-sync oleh KycService saat approve/reject/revoke
  kycStatus     KycStatus @default(UNVERIFIED)
  kycApprovedAt DateTime?

  // Kahade Plus flag denormalized — di-sync oleh SubscriptionService
  isKahadePlus          Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  // kahadePlusSince = tanggal PERTAMA kali user subscribe Kahade Plus. Tidak pernah
  // di-reset saat langganan expire/renew — dipakai badge "Kahade+" dan bagian
  // "Tentang" di profil publik ("Plus member sejak ..."). Di-sync oleh
