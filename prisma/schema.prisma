// ============================================================
// PASSWORD HISTORY
// ============================================================

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String // bcrypt hash dari password lama — digunakan untuk cek password cycling
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("password_histories")
}

// ============================================================
// ADMIN
// ============================================================

model AdminUser {
  id       String    @id @default(cuid())
  adminId  String    @unique // Format: ADMIN-XXXXX
  fullName String
  email    String    @unique
  password String // bcrypt cost 14
  role     AdminRole

  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  lastLoginIp  String?
  mfaSecret    String? // TOTP wajib untuk admin (encrypted AES-256)
  isMfaEnabled Boolean   @default(false)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // AUT-011: true = admin WAJIB mengganti password saat login berikutnya
  // (dibuat baru / di-reset SUPER_ADMIN). Login menerbitkan tempToken scope
  // admin_password_change, bukan sesi.
  mustChangePassword Boolean @default(false)

  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  auditLogs                       AdminAuditLog[]
  kycReviews                      KycRequest[]           @relation("KycReviewer")
  // Review verifikasi badan usaha — relasi terpisah dari kycReviews karena
  // BusinessVerification adalah domain verifikasi yang berbeda.
  businessVerificationReviews     BusinessVerification[] @relation("BusinessVerificationReviewer")
  businessVerificationAssignments BusinessVerification[] @relation("BusinessVerificationAssignee")
  kycAssignments                  KycRequest[]           @relation("KycAssignee")
  assignedDisputes                Dispute[]              @relation("DisputeAssignedAdmin")
  disputeDecisions                DisputeDecision[]      @relation("DisputeDecider")

  disputeEvidences      DisputeEvidence[]      @relation("DisputeEvidenceAdmin")
  disputeMessages       DisputeMessage[]       @relation("DisputeMessageAdmin")
  // BAI-095: catatan internal sengketa yang ditulis admin ini.
  disputeInternalNotes  DisputeInternalNote[]  @relation("DisputeInternalNoteAdmin")
  // GAP-E admin ops (G376–G400)
  emergencyAccessGrants EmergencyAccessGrant[]
  userExportAudits      UserExportAudit[]
  adminSessions         AdminSession[]

  // GAP-F G426–G450 (append-only): relasi balik moderasi Q&A.
  qaReportAssignments QaReport[]               @relation("QaReportAssignee")
  qaModerationEvents  QaModerationEvent[]      @relation("QaEventActor")
  qaDeleteRequests    QaDeleteRequest[]        @relation("QaDeleteRequester")
  qaDeleteApprovals   QaDeleteRequest[]        @relation("QaDeleteApprover")
  qaHiddenQuestions   ProfileQuestion[]        @relation("QaQuestionHider")
  qaAssignedQuestions ProfileQuestion[]        @relation("QaQuestionAssignee")
  qaHiddenComments    ProfileQuestionComment[] @relation("QaCommentHider")
  qaAssignedComments  ProfileQuestionComment[] @relation("QaCommentAssignee")

  @@index([isActive]) // query "semua admin aktif"
  @@index([deletedAt]) // soft-delete query optimization
  @@index([createdBy]) // query "semua admin yang dibuat oleh super admin X"
  @@map("admin_users")
}

model AdminAuditLog {
  id      String    @id @default(cuid())
  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  action     AuditAction
  targetType String?
  targetId   String?

  description String @db.Text
  before      Json?
  after       Json?

  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetId, targetType])
  @@index([createdAt])
  @@index([action]) // filter audit logs by action type
  @@map("admin_audit_logs")
}

// ============================================================
// SYSTEM
// ============================================================

model SystemConfig {
  id          String               @id @default(cuid())
  key         String               @unique
  value       String               @db.Text
  description String?
  dataType    SystemConfigDataType @default(STRING)
  isPublic    Boolean              @default(false)

  updatedBy String? // Admin ID (soft FK ke admin_users.id)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model WebhookLog {
  id            String  @id @default(cuid())
  source        String // 'MIDTRANS', 'MIDTRANS_IRIS'
  event         String
  payload       Json
  headers       Json?
  transactionId String?
  // Stable key: provider + transaction id + status. Nullable for legacy rows.
  eventKey      String? @unique

  isProcessed    Boolean   @default(false)
  processedAt    DateTime?
  errorMessage   String?
  retryCount     Int       @default(0)
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  deadLetteredAt DateTime?

  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // B1-008 (perf): [source, isProcessed] redundan terhadap
  // [source, isProcessed, nextRetryAt] — di-drop di migrasi
  // 20261010000000_perf_b1_indexes.
  @@index([source, event])
  @@index([createdAt])
  @@index([transactionId])
  @@index([source, isProcessed, nextRetryAt])
  @@index([deadLetteredAt])
  @@map("webhook_logs")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // dengan AdminAuditLog.action yang sudah menggunakan AuditAction enum.
  action      UserAuditAction
  entityType  String
  entityId    String
  description String          @db.Text
  before      Json?
  after       Json?

  ipAddress String?
  userAgent String?
  requestId String? // X-Request-ID header

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entityId, entityType])
  @@index([createdAt])
  @@index([action]) // filter by action type
  @@index([requestId]) // request tracing dan debugging via X-Request-ID
  @@map("audit_logs")
}

// ============================================================
// ORDER LINKS (Transaksi via Link)
// ============================================================

model OrderLink {
  id          String   @id @default(cuid())
  linkId      String   @unique
  token       String   @unique
  creatorId   String
  creator     User     @relation("OrderLinkCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorRole UserRole

  title                String            @db.VarChar(100)
  description          String            @db.VarChar(500)
  orderType            OrderType
  orderValue           BigInt
  feeResponsibility    FeeResponsibility
  deliveryDeadlineDays Int
  deliveryDeadlineAt   DateTime? // T3 (audit 2026-09-26): tanggal tenggat eksplisit pilihan creator link; diteruskan ke Order.deliveryDeadlineAt saat accept
  counterpartUsername  String?

  status       OrderLinkStatus @default(ACTIVE)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?           @relation("OrderLinkAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  orders Order[]

  // SH-B-011 (audit etalase 2026-09-27): asal etalase — kolom nullable
  // additive-only. priceSnapshot = harga etalase (RUPIAH integer) saat link
  // dibuat; HANYA pencatatan, tidak memengaruhi escrow/wallet.
  showcaseId    String?
  showcase      UserShowcase? @relation("OrderLinkShowcase", fields: [showcaseId], references: [id], onDelete: SetNull)
  priceSnapshot BigInt?

  // TRX-009: ID alamat pengiriman (buku alamat milik pembuat) untuk link
  // PHYSICAL_GOODS yang dibuat dengan peran BUYER. Link SELLER: alamat
  // diisi penerima via body accept. Divalidasi ulang + di-snapshot
  // terenkripsi ke Order.shipping* saat accept.
  shippingAddressId String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([showcaseId]) // SH-B-011: analitik konversi etalase → order
  @@map("order_links")
}

// ============================================================
// DELIVERY PROOF
// ============================================================

model DeliveryProof {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  submittedBy String
  submitter   User     @relation("DeliveryProofSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  description String   @db.Text
  fileUrls    String[]
  linkUrls    String[]

  status          DeliveryProofStatus @default(SUBMITTED)
  reviewWindowEnd DateTime?
  reviewedAt      DateTime?
  rejectionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([status, reviewWindowEnd])
  @@map("delivery_proofs")
}

// ============================================================
// RATING REPLY
// ============================================================

model RatingReply {
  id       String @id @default(cuid())
  ratingId String @unique
  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  replierId String
  replier   User   @relation("RatingReplies", fields: [replierId], references: [id], onDelete: Restrict)
  content   String @db.VarChar(500)

  isHidden Boolean   @default(false)
  hiddenAt DateTime?
  hiddenBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ratingId])
  @@index([replierId])
  @@map("rating_replies")
