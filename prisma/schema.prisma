// ============================================================
// PROFILE Q&A
// ============================================================

model ProfileQuestion {
  id         String @id @default(cuid())
  askerId    String
  asker      User   @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("QuestionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  question   String    @db.VarChar(500)
  answer     String?   @db.VarChar(1000)
  answeredAt DateTime?

  isPublic     Boolean              @default(true)
  isHidden     Boolean              @default(false)
  /// Section 4: `isHidden` polos digantikan alasan kategoris. Menyembunyikan
  /// pertanyaan tanpa mengisi alasan ditolak di level service dan di level DB
  /// (constraint profile_question_hidden_fields_consistent).
  hiddenReason ContentHiddenReason?
  hiddenAt     DateTime?
  hiddenBy     String?              @db.VarChar(100)

  /// Section 4: jumlah upvote. Denormalisasi + atomic increment (pola
  /// TransactionTemplatesService.recordUsage) supaya urutan "terpopuler" tidak
  /// perlu COUNT(*) per baris.
  upvoteCount    Int       @default(0)
  /// Section 4: penanda pengingat 48 jam sudah dikirim. Sekali per pertanyaan —
  /// job reminder mengklaim baris ini dengan updateMany bersyarat sehingga dua
  /// instance yang balapan tidak mengirim dua notifikasi.
  reminderSentAt DateTime?

  // GAP-F G428/G429/G434/G446 (append-only): kolom moderasi platform.
  /// G428 — OWNER = hide self-service pemilik profil; MODERATOR = hide platform.
  hiddenByType    QaHiddenByType? @map("hidden_by_type")
  /// G428 — admin yang melakukan hide/unhide via jalur moderator.
  hiddenByAdminId String?         @map("hidden_by_admin_id")
  hiddenByAdmin   AdminUser?      @relation("QaQuestionHider", fields: [hiddenByAdminId], references: [id], onDelete: SetNull)
  /// G434 — versi teredaksi (PII disensor); original TIDAK pernah diubah.
  redactedText    String?         @map("redacted_text") @db.VarChar(500)
  /// G429 — catatan internal moderator (hanya admin).
  moderatorNote   String?         @map("moderator_note") @db.Text
  /// G446 — assignment kasus.
  assignedAdminId String?         @map("assigned_admin_id")
  assignedAdmin   AdminUser?      @relation("QaQuestionAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ProfileQuestionComment[]
  upvotes  ProfileQuestionUpvote[]

  @@index([receiverId])
  @@index([askerId])
  @@index([receiverId, isPublic, isHidden])
  @@index([hiddenByType, isHidden])
  // Job reminder 48 jam: scan pertanyaan belum dijawab yang belum diingatkan.
  @@index([answeredAt, reminderSentAt, createdAt])
  // Urutan "terpopuler" di Q&A publik.
  @@index([receiverId, isPublic, isHidden, upvoteCount])
  @@map("profile_questions")
}

/// Section 4 — upvote pertanyaan profil. Unique (userId, questionId) ditegakkan
/// di DB agar dua request balapan tidak menghasilkan upvote ganda / counter
/// melenceng.
model ProfileQuestionUpvote {
  id         String          @id @default(cuid())
  questionId String
  question   ProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId, createdAt, id])
  @@index([userId])
  @@map("profile_question_upvotes")
}

model ProfileQuestionComment {
  id         String                   @id @default(cuid())
  questionId String
  question   ProfileQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     ProfileQuestionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ProfileQuestionComment[] @relation("CommentReplies")

  content      String               @db.VarChar(1000)
  isHidden     Boolean              @default(false)
  /// Section 4: alasan moderasi kategoris, sama seperti ProfileQuestion dan
  /// ShowcaseComment (ContentHiddenReason).
  hiddenReason ContentHiddenReason?
  hiddenAt     DateTime?
  hiddenBy     String?              @db.VarChar(100)

  // GAP-F G428/G429/G434/G446 (append-only): kolom moderasi platform.
  hiddenByType    QaHiddenByType? @map("hidden_by_type")
  hiddenByAdminId String?         @map("hidden_by_admin_id")
  hiddenByAdmin   AdminUser?      @relation("QaCommentHider", fields: [hiddenByAdminId], references: [id], onDelete: SetNull)
  redactedText    String?         @map("redacted_text") @db.VarChar(1000)
  moderatorNote   String?         @map("moderator_note") @db.Text
  assignedAdminId String?         @map("assigned_admin_id")
  assignedAdmin   AdminUser?      @relation("QaCommentAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([authorId])
  @@index([hiddenByType, isHidden])
  @@index([parentId])
  @@map("profile_question_comments")
}

// ============================================================
// CAMPAIGNS (Promo & Marketing)
// ============================================================

model Campaign {
  id          String         @id @default(cuid())
  campaignId  String         @unique
  name        String
  description String?        @db.Text
  type        CampaignType
  status      CampaignStatus @default(DRAFT)

  discountValue    BigInt?
  discountPercent  Decimal? @db.Decimal(5, 2)
  maxDiscount      BigInt?
  freeTransactions Int?

  // Catatan tampilan admin saja — targeting logic memakai field terstruktur di bawah.
  targetAudience     String?
  // Minimum rank target campaign; NULL berarti semua rank.
  targetMinRank      MembershipRank?
  // User tanpa order COMPLETED dalam N hari terakhir; NULL berarti tidak difilter.
  targetDormantDays  Int?
  // Jika true, hanya user yang belum pernah COMPLETED order.
  targetNewUserOnly  Boolean         @default(false)
  // Kode promo unik untuk campaign subscription discount.
  promoCode          String?         @unique
  maxRedemptions     Int?
  currentRedemptions Int             @default(0)
  rolloutPercent     Int?

  startsAt  DateTime
  endsAt    DateTime
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vouchers Voucher[]

  // GAP-E (G353/G358): riwayat versi kampanye — snapshot JSON sebelum tiap perubahan.
  versions CampaignVersion[]

  @@index([status])
  @@index([status, startsAt, endsAt])
  @@index([type])
  @@index([targetMinRank])
  @@index([promoCode])
  @@map("campaigns")
}

// GAP-E (G353/G358, migrasi 20260927050000_gap_e_admin_ops — tidak ada migrasi baru).
// Satu baris per perubahan kampanye: snapshot JSON campaign SEBELUM perubahan,
// siapa yang mengubah, dan alasan perubahan (wajib).
model CampaignVersion {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version      Int
  payload      Json
  changedBy    String?
  changeReason String?
  createdAt    DateTime @default(now())

  @@unique([campaignId, version])
  @@index([campaignId])
  @@map("campaign_versions")
}

