  orderLinksAccepted        OrderLink[]               @relation("OrderLinkAcceptor")
  transactionTemplates      TransactionTemplate[]     @relation("UserTransactionTemplates")
  idempotencyRecords        IdempotencyRecord[]
  walletFavoriteRecipients  WalletFavoriteRecipient[] @relation("WalletFavoriteOwner")
  walletFavoritedBy         WalletFavoriteRecipient[] @relation("WalletFavoriteRecipient")
  feedbacks                 Feedback[]
  // GAP-A: kredensial passkey/WebAuthn (back-relation, non-breaking).
  passkeyCredentials        PasskeyCredential[]
  // GAP-A: akun sosial tertaut (back-relation, non-breaking).
  socialAccounts            SocialAccount[]
  // GAP-A: permintaan penghapusan akun + riwayat status (back-relation, non-breaking).
  accountDeletionRequests   AccountDeletionRequest[]
  // GAP-A: user dari login sosial dengan nomor sintetis wajib verifikasi
