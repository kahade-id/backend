  chatInApp      Boolean @default(true)
  chatPush       Boolean @default(true)
  disputeInApp   Boolean @default(true)
  disputePush    Boolean @default(true)
  disputeEmail   Boolean @default(true)
  rankingInApp   Boolean @default(true)
  rankingPush    Boolean @default(true)
  marketingEmail Boolean @default(false)
