// Aturan SLA triase konfigurasional per kategori (G168).
model FeedbackSlaRule {
  id         String   @id @default(cuid())
  category   String   @unique @db.VarChar(100)
  hours      Int
  isCritical Boolean  @default(false)
  createdAt  DateTime @default(now())
