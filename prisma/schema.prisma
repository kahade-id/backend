  // G215 konfirmasi terima barang retur
  receivedAt   DateTime?
  receivedNote String?   @db.Text

  // G217 eskalasi ke sengketa: LINK ke dispute existing, jangan buat baru
  disputeId String? // FK logis ke Dispute.id bila sudah ada case aktif

  approvedAt  DateTime?
  rejectedAt  DateTime?
  resolvedAt  DateTime?
  cancelledAt DateTime?
  expiredAt   DateTime?
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments    ReturnAttachment[]
  notes          ReturnNote[]
  timeline       ReturnTimeline[]
  shipmentEvents ReturnShipmentEvent[]
  refundApproval ReturnRefundApproval?

  // G218: partial unique index (status non-terminal) didefinisikan di migration.sql
  @@index([orderId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, sellerRespondBy])
  @@index([status, createdAt])
  @@map("return_requests")
}

// --- G205: foto kondisi + bukti (fileKey dari pipeline upload existing) -------
model ReturnAttachment {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  fileKey         String // dari POST /v1/upload/direct (purpose=return-evidence)
  fileName        String
  fileType        String
  fileSize        Int
  uploadedBy      String
  // G222: retensi bukti — scheduler menghapus fileKey setelah retainUntil
  retainUntil     DateTime?
  purgedAt        DateTime?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
  @@index([retainUntil])
  @@map("return_attachments")
}

// --- G216: negosiasi / catatan terlihat dua pihak -----------------------------
model ReturnNote {
  id              String          @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  authorId        String
  authorRole      ReturnActorType
  message         String          @db.Text
  visibleToBoth   Boolean         @default(true) // false = catatan internal admin
  createdAt       DateTime        @default(now())

  @@index([returnRequestId, createdAt])
  @@map("return_notes")
}

// --- G214/G220: timeline event purnajual + jejak audit append-only -----------
model ReturnTimeline {
  id              String          @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  event           String // mis. STATUS_CHANGED, NOTE_ADDED, REFUND_APPROVED ...
  fromStatus      ReturnStatus?
  toStatus        ReturnStatus?
  actorId         String?
  actorRole       ReturnActorType @default(SYSTEM)
  metadata        Json? // detail bebas (nominal, resi, alasan, dsb.)
  createdAt       DateTime        @default(now())

  @@index([returnRequestId, createdAt])
  @@map("return_timeline")
}

// --- G214: event tracking paket retur -----------------------------------------
model ReturnShipmentEvent {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  trackingNumber  String
  courier         String?
  status          String // status kurir ternormalisasi (PICKED_UP, IN_TRANSIT, DELIVERED, ...)
  location        String?
  eventAt         DateTime      @default(now())
  rawPayload      Json?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId, eventAt])
  @@map("return_shipment_events")
}

// --- G210: persetujuan nominal refund — idempoten, TANPA panggil provider -----
model ReturnRefundApproval {
  id              String               @id @default(cuid())
  returnRequestId String               @unique
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  idempotencyKey  String               @unique // RTN-APPR-<returnId>; panggil 2x = 1 eksekusi
  amount          BigInt // sen, ≤ buyerPayAmount (dan ≤ maxRefundBps bila ada)
  status          RefundApprovalStatus @default(PENDING)
  approvedBy      String // sellerId / adminId penyetuju
  approvedByRole  ReturnActorType
  approvedAt      DateTime             @default(now())
  executedAt      DateTime?
  failureReason   String?              @db.Text
  walletTxIds     String[]             @default([]) // txId ledger ORDER_REFUND terkait
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("return_refund_approvals")
}

// === GAP-D: COURIER (G226–G250) — integrasi kurir & tracking ===
// - Label = fileKey PRIVAT di storage lokal (bukan URL publik); unduhan
//   memakai signed URL terautentikasi dengan expiry singkat.
// ============================================================

// Status tracking internal lintas kurir (G236). UNKNOWN dipakai ketika
// provider timeout / event tak dikenal — JANGAN mengarang status (G240).
enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  UNKNOWN
}

// Mode serah terima paket (G231).
enum ShipmentMode {
  PICKUP
  DROPOFF
}

// Pihak penanggung biaya kirim (G243) — dikontrol SEBELUM payment.
enum ShippingCostBearer {
  SELLER
  BUYER
  SPLIT
}

// Lifecycle booking label di sisi Kahade (G232/G242).
enum ShipmentBookingState {
  DRAFT
  BOOKED
  FAILED
  VOIDED
}

// Status rekonsiliasi tagihan provider vs biaya tercatat (G248).
enum CourierBillStatus {
  DRAFT
  MATCHED
  MISMATCH
  ACKNOWLEDGED
}

// Status refund ongkir (G247).
enum ShippingRefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}

// Katalog kurir + layanan (G227). Seed bawaan NONAKTIF — aktivasi via
// feature flag per provider/wilayah (G249) oleh admin.
model CourierService {
  id              String   @id @default(cuid())
  providerCode    String // mis. "jne", "jnt", "sicepat", "gosend", "anteraja", "paxel", "mock"
  serviceCode     String // mis. "REG", "YES", "SAME_DAY", "INSTANT"
  serviceName     String // nama tampil, mis. "JNE Reguler"
  description     String?
  enabled         Boolean  @default(false)
  // Kode wilayah cakupan (mis. ["ID-JKT", "ID-BDG"] atau ["*"] = nasional).
  regions         String[] @default([])
  supportsPickup  Boolean  @default(true)
  supportsDropoff Boolean  @default(true)
  // SLA keterlambatan = ETA + slaGraceDays (G245), per service level.
  slaGraceDays    Int      @default(2)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerCode, serviceCode])
  @@index([providerCode])
  @@index([enabled])
  @@map("courier_services")
}

// Feature flag per provider + wilayah (G249). Baris (providerCode, "*")
// = flag global provider; (providerCode, region) = override wilayah.
model CourierRegionFlag {
  id           String   @id @default(cuid())
  providerCode String
  region       String // kode wilayah atau "*" untuk global
  enabled      Boolean  @default(false)
  note         String?
  updatedAt    DateTime @updatedAt

  @@unique([providerCode, region])
  @@index([providerCode])
  @@map("courier_region_flags")
}

// Entitas pengiriman tersendiri (G233): booking ID + label provider disimpan
// di sini, BUKAN di tabel orders. Fallback resi manual (G241) juga dicatat
// di sini (isManual=true) — field trackingNumber/courierName di orders
// tetap menjadi milik alur manual E10 yang sudah ada.
model Shipment {
  id       String @id @default(cuid())
  // FK skalar ke orders.id — SENGAJA bukan field relasi Prisma: back-relation
  // di model Order tidak boleh ditambahkan (schema.prisma milik worker lain).
  // FK ON DELETE RESTRICT ada di migration.sql.
  orderId  String @unique
  sellerId String
  buyerId  String

  providerCode String
  serviceCode  String?
  mode         ShipmentMode         @default(PICKUP)
  bookingState ShipmentBookingState @default(DRAFT)
  status       ShipmentStatus       @default(CREATED)

  // Identitas provider (G233).
  providerBookingId String?
  trackingNumber    String?

  // Label = fileKey privat (G233). JANGAN pernah mengekspos fileKey mentah
  // ke klien — unduhan hanya via signed URL terautentikasi (G234).
  labelFileKey  String?
  labelMimeType String?

  // Biaya (G243/G244): estimasi saat quote vs aktual saat booking tercatat
  // TERPISAH. Nilai dalam rupiah (BigInt), konsisten dengan pola wallet.
  costBearer     ShippingCostBearer @default(SELLER)
  estimatedCost  BigInt             @default(0)
  actualCost     BigInt?
  currency       String             @default("IDR")
  refundedAmount BigInt             @default(0)

  weightGrams Int?

  // Kota + kode pos disimpan polos untuk filter/ops; alamat LENGKAP hanya di
  // kolom JSON dan TIDAK PERNAH dikembalikan ke pihak tak berhak (G238).
  originCity       String?
  originPostalCode String?
  destCity         String?
  destPostalCode   String?
  originDetail     Json? // { name, phone, address, city, postalCode } — privat
  destDetail       Json? // { name, phone, address, city, postalCode } — privat

  etaMinDays Int?
  etaMaxDays Int?
  // SLA keterlambatan (G245): slaDueAt = bookedAt + etaMaxDays + slaGraceDays.
  slaDueAt   DateTime?

  lastEventAt      DateTime?
  lastEventRaw     String?
  staleAlertSentAt DateTime?

  // Fallback resi manual (G241): seller mengisi sendiri saat provider nonaktif.
  isManual             Boolean @default(false)
  manualTrackingNumber String?
  manualCourierName    String?

  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      ShipmentEvent[]
  webhookLogs CourierWebhookLog[]
  refunds     ShippingCostRefund[]
  billLines   CourierBillLine[]

  @@index([orderId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([providerCode])
  @@index([trackingNumber])
  @@index([status])
  @@index([bookingState])
  @@index([status, lastEventAt]) // deteksi tracking macet (stale)
  @@map("shipments")
}

// Event tracking per shipment (G236/G237). Dedup via unique
// (shipmentId, providerEventId); provider boleh mengirim out-of-order.
model ShipmentEvent {
  id              String         @id @default(cuid())
  shipmentId      String
  shipment        Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  providerEventId String
  providerCode    String
  rawStatus       String
  status          ShipmentStatus
  // Lokasi termasking, mis. "Jakarta***" / "Hub Bandung" — tanpa alamat lengkap (G238).
  locationMasked  String?
  description     String?
  occurredAt      DateTime?
  createdAt       DateTime       @default(now())

  @@unique([shipmentId, providerEventId])
  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

// Log webhook mentah per provider (G235): verifikasi signature + idempotency.
model CourierWebhookLog {
  id             String    @id @default(cuid())
  providerCode   String
  shipmentId     String?
  shipment       Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  // Idempotency key dari provider (header/body); null bila provider tidak mengirim.
  idempotencyKey String?
  signatureValid Boolean
  payloadHash    String
  outcome        String    @default("RECEIVED") // RECEIVED | PROCESSED | DUPLICATE | REJECTED
  error          String?
  createdAt      DateTime  @default(now())

  @@index([providerCode, createdAt])
  @@index([idempotencyKey])
  @@map("courier_webhook_logs")
}

// Tagihan provider per periode untuk rekonsiliasi (G248).
model CourierProviderBill {
  id             String            @id @default(cuid())
  providerCode   String
  period         String // "YYYY-MM"
  currency       String            @default("IDR")
  billedAmount   BigInt
  recordedAmount BigInt            @default(0)
  status         CourierBillStatus @default(DRAFT)
  notes          String?
  createdBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines CourierBillLine[]

  @@unique([providerCode, period])
  @@index([providerCode])
  @@map("courier_provider_bills")
}

model CourierBillLine {
  id             String              @id @default(cuid())
  billId         String
  bill           CourierProviderBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  shipmentId     String?
  shipment       Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  trackingNumber String?
  billedAmount   BigInt
  recordedAmount BigInt              @default(0)
  delta          BigInt              @default(0) // billedAmount - recordedAmount
  note           String?

  @@index([billId])
  @@index([trackingNumber])
  @@map("courier_bill_lines")
}

// Refund ongkir (G247): diajukan seller/buyer, diputus admin.
model ShippingCostRefund {
  id          String               @id @default(cuid())
  shipmentId  String
  shipment    Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId     String
  amount      BigInt
  reason      String
  status      ShippingRefundStatus @default(REQUESTED)
  requestedBy String
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@map("shipping_cost_refunds")
}

// === GAP-C: Feedback workflow (G151–G175) ===

// Model terpisah dari SupportTicket. adminId disimpan sebagai String polos
// (tanpa FK) agar tidak menyentuh model AdminUser/User yang sudah ada.

enum FeedbackStatus {
  NEW
  IN_REVIEW
  ACTIONED
  CLOSED
}

enum FeedbackCloseReason {
  RESOLVED
  DUPLICATE
  NOT_ACTIONABLE
  SPAM
  OUT_OF_SCOPE
  OTHER
}

enum FeedbackRisk {
  NONE
  SECURITY_RISK
  FRAUD_RISK
}

enum FeedbackAuditAction {
  STATUS_CHANGED
  ASSIGNED
  UNASSIGNED
  TAG_ADDED
  TAG_REMOVED
  NOTE_ADDED
  REPLY_SENT
  CONTACTED
  ESCALATED
  RISK_FLAGGED
  SLA_UPDATED
  CLOSED
  REOPENED
}

model FeedbackAssignment {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  adminId    String
  assignedBy String?
  note       String?  @db.VarChar(500)
