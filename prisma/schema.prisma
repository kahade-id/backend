// ============================================================
// KYC
// ============================================================

model KycRequest {
  id     String @id @default(cuid())
  kycId  String @unique // Format: KYC-YYYYMMDD-SERIAL
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status KycStatus @default(PENDING)

  // Documents (URL signed, encrypted AES-256)
  ktpPhotoUrl    String // URL encrypted ke S3 private
  selfiePhotoUrl String // URL encrypted ke S3 private
  ktpNumber      String // NIK, encrypted AES-256
  // HMAC-SHA256 deterministik dari NIK — untuk cek duplikat lintas akun
  // AES non-deterministik (IV random) tidak bisa di-unique.
  // Hash ini TIDAK bisa di-decrypt ke NIK asli (one-way).
  ktpNumberHash  String // HMAC-SHA256(NIK, HMAC_SECRET_KEY); active-state uniqueness is enforced by migration

  // Review — FK ke AdminUser
  reviewedBy      String? // Admin user ID (FK ke admin_users.id)
  reviewer        AdminUser? @relation("KycReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  adminNotes      String?    @db.Text

  // Metadata
  submittedIp   String?
  attemptNumber Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CREATE UNIQUE INDEX kyc_one_pending_per_user ON kyc_requests(user_id)
  // WHERE status = 'PENDING';

  @@index([userId])
  @@index([status])
  @@index([ktpNumberHash])
  @@index([status, createdAt]) // compound untuk admin KYC queue: status-filter + sort by date
  @@index([reviewedBy]) // index untuk admin performance analytics
  @@map("kyc_requests")
}

// ============================================================
// BUSINESS VERIFICATION (badge "Business Verified")
// ============================================================
//
// Verifikasi badan usaha — BEDA domain dari KycRequest (personal/KTP). Hanya
// boleh diajukan oleh akun dengan accountType == BUSINESS; enforcement di
// BusinessVerificationService, bukan di DB (accountType bisa berubah).
//
// Review lewat admin console dengan pola yang sama persis seperti admin-kyc.service.ts:
// queue FIFO per status, approve/reject/revoke dengan guard `status = 'PENDING'`
// di dalam transaction Serializable supaya dua admin tidak double-process.
model BusinessVerification {
  id             String @id @default(cuid())
  verificationId String @unique // Format: BIZ-YYYYMMDD-SERIAL-SUFFIX
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status BusinessVerificationStatus @default(PENDING)

  // Identitas badan usaha
  businessName   String  @db.VarChar(150)
  // NPWP disimpan terenkripsi AES-256 (pola sama seperti BankAccount.accountNumber).
  npwpNumber     String
  // HMAC-SHA256 deterministik dari NPWP untuk deteksi duplikat lintas akun.
  // AES non-deterministik (IV random) tidak bisa di-unique, jadi uniqueness
  // pakai hash satu arah ini — sama seperti KycRequest.ktpNumberHash.
  // Partial-unique (hanya PENDING/APPROVED) ditegakkan lewat migration, bukan
  // @unique di sini, supaya submission yang REJECTED/REVOKED tidak memblokir
  // pengajuan ulang dengan NPWP yang sama.
  npwpNumberHash String
  // Nomor akta pendirian / SIUP — minimal salah satu wajib diisi (divalidasi di DTO).
  deedNumber     String? @db.VarChar(100)
  siupNumber     String? @db.VarChar(100)

  // Dokumen pendukung: fileKey R2 private-bucket yang sudah dikonfirmasi lewat
  // POST /upload/confirm (pola sama seperti KYC ktpFileKey/selfieFileKey).
  // Tiap entri disimpan TERENKRIPSI AES-256 (pola KycRequest.ktpPhotoUrl) supaya
  // DB dump tidak membocorkan nama file dokumen legalitas. Admin me-mint signed
  // URL short-lived saat review (lihat AdminBusinessVerificationService.getDocumentUrls).
  documentFileKeys String[]

  // Review — FK ke AdminUser (SetNull agar riwayat tetap ada saat admin dihapus)
  reviewedBy      String?
  reviewer        AdminUser? @relation("BusinessVerificationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  // approvedAt dipertahankan setelah REVOKED (untuk audit) — badge "Business
  // Verified" memakai status, bukan approvedAt.
  approvedAt      DateTime?
  revokedAt       DateTime?
  rejectionReason String?
  adminNotes      String?    @db.Text

  // Metadata
  submittedIp   String?
  attemptNumber Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CREATE UNIQUE INDEX business_verification_one_pending_per_user
  //   ON business_verifications(user_id) WHERE status = 'PENDING';
  // CREATE UNIQUE INDEX business_verification_active_npwp_unique
  //   ON business_verifications(npwp_number_hash) WHERE status IN ('PENDING','APPROVED');

  @@index([userId])
  @@index([status])
  @@index([npwpNumberHash])
  @@index([status, createdAt]) // admin review queue: status-filter + sort by date
  @@index([reviewedBy])
  @@map("business_verifications")
}

// ============================================================
// BANK ACCOUNTS
// ============================================================

model BankAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  bankCode          BankCode
  bankName          String
  accountNumber     String // Encrypted AES-256
  accountName       String
  // Deterministik untuk duplicate detection lintas user.
  // NULL untuk data lama yang belum di-backfill.
  accountNumberHash String?  @unique
  isPrimary         Boolean  @default(false)
  // CREATE UNIQUE INDEX bank_one_primary_per_user
  //   ON bank_accounts(user_id)
  //   WHERE is_primary = true AND deleted_at IS NULL;
  isVerified        Boolean  @default(false) // Verified via penny-drop atau manual

  // Midtrans Iris
  irisAccountId String? // Iris beneficiary account ID
  // CREATE UNIQUE INDEX bank_iris_account_unique
  //   ON bank_accounts(iris_account_id)
  //   WHERE iris_account_id IS NOT NULL;
  // Mencegah pendaftaran rekening yang sama dua kali ke Iris.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  withdrawTransactions WalletTransaction[]
  scheduledWithdrawals ScheduledWithdrawal[] @relation("BankAccountScheduledWithdrawals")

  @@index([userId])
  @@index([irisAccountId]) // Iris webhook lookup "find bank account by Iris ID"
  @@index([userId, deletedAt]) // WHERE userId=? AND deletedAt IS NULL
  @@index([deletedAt]) // soft-delete query optimization
  @@map("bank_accounts")
}

// ============================================================
// WALLET
// ============================================================

model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Saldo dalam satuan sen (IDR x 100)
  availableBalance BigInt @default(0) // Saldo Tersedia
  escrowBalance    BigInt @default(0) // Saldo dalam Escrow
  // WAJIB update ketiganya atomik dalam 1 Prisma $transaction.
  // Invariant enforced in production: totalBalance = availableBalance + escrowBalance.
  // Withdrawal reservations decrement availableBalance and totalBalance together,
  // including the PENDING_OTP window; cancellation/failure refunds both together.
  totalBalance     BigInt @default(0)
  // Production migration enforces non-negative balances and
  // total_balance = available_balance + escrow_balance.

  // Daily limits tracking (stored in SEN — IDR x 100)
  todayTopupAmount    BigInt    @default(0)
  todayWithdrawAmount BigInt    @default(0)
  lastLimitResetAt    DateTime  @default(now()) // Di-reset setiap midnight WIB oleh cron job
  lastTopupAt         DateTime? // Timestamp top-up terakhir berhasil (diset oleh handleTopupSuccess)

  walletPinHash String?

  // Security
  isLocked   Boolean   @default(false)
  lockedAt   DateTime?
  lockReason String?
  lockedBy   String? // Admin ID (soft FK ke admin_users.id)

  version   Int       @default(0) // Optimistic locking
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(cuid())
  txId     String @unique // Format: WLT-YYYYMMDD-SERIAL
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type   WalletTransactionType
  status WalletTransactionStatus @default(PENDING)

  // Amounts in sen (IDR x 100)
  amount        BigInt // Selalu positif
  balanceBefore BigInt // Snapshot sebelum transaksi
  balanceAfter  BigInt // Snapshot setelah transaksi
  // ALTER TABLE wallet_transactions ADD CONSTRAINT wallet_tx_amounts_valid
  //   CHECK (
  //     amount > 0 AND
  //     balance_before >= 0 AND
  //     balance_after >= 0
  //   );
  // ALTER TABLE wallet_transactions ADD CONSTRAINT wallet_tx_no_self_reversal
  //   CHECK (reversal_tx_id IS NULL OR reversal_tx_id != id);

  // References
  orderId       String?
  order         Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentTxId   String?
  paymentTx     PaymentTransaction? @relation(fields: [paymentTxId], references: [id], onDelete: SetNull)
  bankAccountId String?
  bankAccount   BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  // Metadata
  description   String
  metadata      Json?
  failureReason String?

  reversalTxId String?
  reversalTx   WalletTransaction?  @relation("ReversalTransaction", fields: [reversalTxId], references: [id], onDelete: SetNull)
  reversals    WalletTransaction[] @relation("ReversalTransaction")

  // Withdraw specific
  withdrawStatus WithdrawStatus?
  irisPayoutId   String? // Midtrans Iris payout ID
  // CREATE UNIQUE INDEX wallet_tx_iris_payout_unique
  //   ON wallet_transactions(iris_payout_id)
  //   WHERE iris_payout_id IS NOT NULL;
  irisRef        String? // Iris reference number

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([walletId])
  @@index([orderId])
  @@index([type, status])
  @@index([createdAt])
  @@index([type, status, createdAt])
  @@index([walletId, createdAt]) // paginated transaction history
  @@index([walletId, type, status]) // "semua TOP_UP PENDING untuk wallet ini"
  @@index([withdrawStatus]) // withdrawal pipeline queries
  @@index([bankAccountId])
  @@index([paymentTxId])
  @@index([reversalTxId])
  @@index([irisPayoutId]) // performance index untuk webhook lookup
  @@map("wallet_transactions")
}

// ============================================================
// PAYMENTS (Midtrans)
// ============================================================

model PaymentTransaction {
  id              String  @id @default(cuid())
  midtransOrderId String  @unique // Order ID di Midtrans
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  provider PaymentProvider @default(MIDTRANS)
  purpose  PaymentPurpose  @default(TOPUP)
  method   PaymentMethod
  status   PaymentStatus   @default(PENDING)

  // Amounts in IDR sen
  amount         BigInt
  paymentFee     BigInt @default(0)
  grossAmount    BigInt @default(0)
  refundedAmount BigInt @default(0)
  currency       String @default("IDR")

  // Midtrans response
  midtransToken        String?
  midtransRedirectUrl  String?
  vaNumber             String?
  vaBank               String?
  qrCodeUrl            String?
  deepLinkUrl          String?
  providerInstructions Json?

  // Webhook data
  webhookReceivedAt DateTime?
  webhookPayload    Json?
  fraudStatus       String?

  // Timestamps
  expiredAt         DateTime?
  paidAt            DateTime?
  settledAt         DateTime? // Diset saat Midtrans SETTLEMENT webhook diterima (handleTopupSuccess)
  failedAt          DateTime? // Diset saat Midtrans DENY/EXPIRE/CANCEL webhook diterima (handleTopupFailure)
  refundRequestedAt DateTime?
  refundReference   String?
  refundReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  walletTransactions WalletTransaction[]
  subscriptions      Subscription[]
  voucherUsages      VoucherUsage[]

  @@index([userId])
  @@index([orderId])
  @@index([purpose, status])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id       String @id @default(cuid())
  orderId  String @unique // Format: ORD-YYYYMMDD-SERIAL
  buyerId  String
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId String
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)

  // Order Details
  title       String    @db.VarChar(100)
  description String    @db.VarChar(500)
  orderType   OrderType

  // Financial (in sen / IDR x 100)
  orderValue          BigInt
  feeAmount           BigInt
  feeResponsibility   FeeResponsibility
  buyerFeeAmount      BigInt
  sellerFeeAmount     BigInt
  buyerPayAmount      BigInt // Total yang buyer bayar (orderValue + buyerFeeAmount)
  sellerReceiveAmount BigInt // Total yang seller terima (orderValue - sellerFeeAmount)
  // ALTER TABLE orders ADD CONSTRAINT order_fee_sum
  //   CHECK (buyer_fee_amount + seller_fee_amount = fee_amount);
  // ALTER TABLE orders ADD CONSTRAINT order_buyer_pay
  //   CHECK (buyer_pay_amount = order_value + buyer_fee_amount);
  // ALTER TABLE orders ADD CONSTRAINT order_seller_receive
  //   CHECK (seller_receive_amount = order_value - seller_fee_amount);

  // Voucher
  voucherId              String?
  voucher                Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  // NULL vs 0 ambigu di application layer — gunakan 0 untuk "tidak ada diskon".
  voucherDiscount        BigInt   @default(0)
  // Diskon tambahan karena MembershipRank (GOLD+), terpisah dari voucher/Kahade+.
  membershipRankDiscount BigInt   @default(0)

  // Kahade Plus flag
  isKahadePlus Boolean @default(false)
  feeRate      Decimal @db.Decimal(5, 4)

  // Status
  status       OrderStatus        @default(WAITING_CONFIRMATION)
  cancelReason OrderCancelReason?
  cancelNote   String?

  // Deadlines
  deliveryDeadlineDays   Int       @default(3)
  // ALTER TABLE orders ADD CONSTRAINT delivery_deadline_range
  //   CHECK (delivery_deadline_days BETWEEN 1 AND 14);
  deliveryDeadlineAt     DateTime? // Nullable — diset saat paidAt
  paymentDeadlineAt      DateTime?
  confirmationDeadlineAt DateTime?
  processingDeadlineAt   DateTime?

  // Shipping
  trackingNumber String?
  courierName    String?
  trackingNotes  String?

  // Timestamps per state
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  paidAt      DateTime?
  processedAt DateTime?
  shippedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  disputedAt  DateTime?
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Creator
  createdByBuyer Boolean @default(false) // true jika order dibuat oleh buyer; false jika oleh seller. Selalu di-set eksplisit saat INSERT.

  // Reference attachments for order spec (2.1)
  attachments String[] @default([])

  // Source inquiry room that spawned this order (2.6) — links negotiation context
  sourceInquiryRoomId String?
  sourceInquiryRoom   ChatRoom? @relation("OrderSourceInquiry", fields: [sourceInquiryRoomId], references: [id], onDelete: SetNull)

  // Order Link reference
  orderLinkId String?
  orderLink   OrderLink? @relation(fields: [orderLinkId], references: [id], onDelete: SetNull)

  // Relations
  statusHistories     OrderStatusHistory[]
  chatRoom            ChatRoom?
  dispute             Dispute?
  ratings             Rating[]
  walletTransactions  WalletTransaction[]
  extensionRequests   OrderExtensionRequest[]
  voucherUsages       VoucherUsage[]
  referralRewards     ReferralReward[]
  paymentTransactions PaymentTransaction[]
  deliveryProofs      DeliveryProof[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([status, createdAt]) // admin order queue: status-filter + sort by date
  @@index([createdAt])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([voucherId]) // FK tanpa index = full table scan
  @@index([trackingNumber]) // admin lookup order via tracking number kurir
  @@index([status, deliveryDeadlineAt]) // auto-complete scheduler: WHERE status=IN_DELIVERY AND deliveryDeadlineAt < NOW()
  @@index([status, paymentDeadlineAt]) // payment cleanup scheduler
  @@index([status, confirmationDeadlineAt]) // confirmation timeout scheduler
  @@index([status, processingDeadlineAt]) // processing timeout scheduler
  @@index([orderLinkId])
  @@map("orders")
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus    OrderStatus?
  toStatus      OrderStatus
  changedBy     String? // User ID atau 'SYSTEM'
  changedByType ActorType? // Menggantikan String? — BUYER, SELLER, ADMIN, SYSTEM
  reason        String?
  metadata      Json?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_histories")
}

model OrderExtensionRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestedBy String // User ID yang request

  // Tanpa FK, user yang dihapus tidak trigger cascade dan data menjadi orphan.
  requester       User     @relation("ExtensionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  requestedByRole UserRole // Menggantikan String — BUYER atau SELLER
  extensionDays   Int
  // ALTER TABLE order_extension_requests ADD CONSTRAINT extension_days_range
  //   CHECK (extension_days BETWEEN 1 AND 14);
  reason          String

  status      DeadlineExtensionStatus @default(PENDING)
  respondedBy String?

  responder     User?     @relation("ExtensionResponder", fields: [respondedBy], references: [id], onDelete: SetNull)
  respondedAt   DateTime?
  rejectionNote String?
  expiresAt     DateTime? // Auto-expire if not responded within X hours (e.g. 48h)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Tambah updatedAt — status bisa berubah

  @@index([orderId])
  @@index([orderId, status]) // Compound index untuk query "ada pending extension?"
  @@index([requestedBy])
  @@index([respondedBy])
  @@index([status, expiresAt])
  @@map("order_extension_requests")
}

// ============================================================
// CHAT
// ============================================================

model ChatRoom {
  id String @id @default(cuid())

  // ORDER room: selalu punya order. INQUIRY room (pra-transaksi): orderId NULL.
  // Dibuat nullable lewat migration 20260913_chat_trust_safety_and_features.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type   ChatRoomType   @default(ORDER)
  status ChatRoomStatus @default(ACTIVE)

  // Pasangan peserta. Untuk ORDER room nilainya disalin dari order saat room
  // dibuat (dan di-backfill untuk room lama); untuk INQUIRY room diisi saat
  // room dibuat. Menjadi sumber kebenaran untuk authorization supaya chat
  // pra-transaksi tidak perlu punya order.
  initiatorId   String?
  initiator     User?   @relation("ChatRoomInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)
  counterpartId String?
  counterpart   User?   @relation("ChatRoomCounterpart", fields: [counterpartId], references: [id], onDelete: SetNull)

  // Konteks percakapan pra-transaksi (mis. judul barang yang dinegosiasikan).
  subject String? @db.VarChar(200)

  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messages         ChatMessage[]
  members          ChatRoomMember[]
  moderationEvents ChatModerationEvent[]
  spawnedOrders    Order[]            @relation("OrderSourceInquiry")

  @@index([type, initiatorId])
  @@index([type, counterpartId])
  @@index([type, status])
  @@map("chat_rooms")
}

model ChatMessage {
  id       String   @id @default(cuid())
  roomId   String
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId String? // Null untuk sistem message
  sender   User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  messageType ChatMessageType @default(TEXT)
  content     String?         @db.Text
  isEdited    Boolean         @default(false)
  editedAt    DateTime? // Diisi oleh editMessage(); sebelumnya isEdited tidak pernah di-set true.
  isDeleted   Boolean         @default(false)
  deletedAt   DateTime?

  // Isi asli yang dipertahankan saat pesan dihapus. Pesan yang sudah masuk masa
  // sengketa tidak boleh hilang begitu saja — resolver dispute dan admin harus
  // tetap bisa membaca bukti percakapannya.
  deletedContent String? @db.Text
  deletedById    String?

  // Voice note.
  durationSeconds Int?

  // Pin message (alamat kirim, nomor resi, dsb).
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("ChatMessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)

  // Forward: pesan hasil forward menunjuk ke pesan aslinya.
  forwardedFromId String?
  forwardedFrom   ChatMessage?  @relation("ChatMessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        ChatMessage[] @relation("ChatMessageForward")

  // Hasil moderasi teks (ringkasan). Detail kecocokan ada di ChatModerationEvent.
  moderationAction   ChatModerationAction?
  moderationSeverity ChatModerationSeverity?
  moderationKind     ChatModerationKind?

  readAt Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replyToId String?
  replyTo   ChatMessage?  @relation("ChatMessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatMessageReply")

  attachments ChatAttachment[]
  reactions   ChatMessageReaction[]
  editHistory ChatMessageEdit[]

  @@index([roomId])
  @@index([roomId, createdAt]) // cursor-based pagination (ORDER BY createdAt DESC)
  @@index([roomId, isPinned])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("chat_messages")
}

// Satu emoji per (user, pesan, emoji). Seorang user boleh memberi beberapa emoji
// berbeda pada pesan yang sama (model Slack), bukan satu reaksi saja.
model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(16)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("chat_message_reactions")
}

// Riwayat revisi pesan. Tanpa ini, "edit pesan" = menghapus bukti secara diam-diam
// — sama berbahayanya dengan delete saat order berstatus DISPUTED.
model ChatMessageEdit {
  id              String      @id @default(cuid())
  messageId       String
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editorId        String
  editor          User        @relation(fields: [editorId], references: [id], onDelete: Cascade)
  previousContent String?     @db.Text
  createdAt       DateTime    @default(now())

  @@index([messageId, createdAt])
  @@map("chat_message_edits")
}

// Status per peserta: arsip & mute. ChatRoom.isArchived bersifat global sehingga
// tidak bisa dipakai untuk "saya arsipkan, lawan bicara tidak".
model ChatRoomMember {
  id     String             @id @default(cuid())
  roomId String
  room   ChatRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   ChatRoomMemberRole @default(BUYER)

  isArchived Boolean   @default(false)
  archivedAt DateTime?
  isMuted    Boolean   @default(false)
  mutedUntil DateTime?
  lastReadAt DateTime?

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([userId, isArchived])
  @@index([userId, isMuted])
  @@map("chat_room_members")
}

// Jejak audit Trust & Safety. Pesan yang DIBLOKIR tidak tersimpan, sehingga ini
// satu-satunya rekam jejaknya — sekaligus antrean moderasi untuk admin.
model ChatModerationEvent {
  id      String @id @default(cuid())
  eventId String @unique // Format: CME-YYYYMMDD-<random>

  roomId    String?
  room      ChatRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  messageId String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     ChatModerationKind
  severity ChatModerationSeverity
  action   ChatModerationAction
  // Id matcher + matcher yang ikut ter-absorb. Dipakai admin untuk memfilter
  // antrean tanpa perlu membuka isi pesan.
  matchers Json?
  // Potongan teks yang memicu deteksi. Untuk aksi BLOCKED ini satu-satunya jejak
  // isi pesan, sehingga wajib ada dan dibatasi panjangnya.
  snippet  String?                @db.VarChar(280)

  status       ChatModerationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?              @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([userId, createdAt])
  @@index([roomId])
  @@index([action])
  @@map("chat_moderation_events")
}

model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName     String
  fileSize     Int // bytes
  mimeType     String
  fileUrl      String // CDN URL
  thumbnailUrl String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([createdAt]) // sort attachments by date for attachment history queries
  @@map("chat_attachments")
}

// ============================================================
// DISPUTES
// ============================================================

model Dispute {
  id        String @id @default(cuid())
  disputeId String @unique // Format: DSP-YYYYMMDD-SERIAL
  orderId   String @unique
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  initiatedBy     DisputeInitiator
  initiatorUserId String
  initiator       User             @relation("DisputeInitiatorUser", fields: [initiatorUserId], references: [id], onDelete: Restrict)

  buyerClaim      String?   @db.Text
  sellerClaim     String?   @db.Text
  buyerClaimedAt  DateTime?
  sellerClaimedAt DateTime?

  status          DisputeStatus @default(OPEN)
  assignedAdminId String?
  assignedAdmin   AdminUser?    @relation("DisputeAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAt      DateTime?
  resolvedAt      DateTime?

  // SLA tracking
  slaHours      Int?
  // ALTER TABLE disputes ADD CONSTRAINT dispute_sla_hours_positive
  //   CHECK (sla_hours IS NULL OR sla_hours > 0);
  slaDeadlineAt DateTime?
  isSlaBreached Boolean   @default(false)

  adminNotes String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  evidences       DisputeEvidence[]
  decision        DisputeDecision?
  calls           DisputeCall[]
  messages        DisputeMessage[]
  mutualProposals MutualResolutionProposal[]

  @@index([status])
  @@index([status, createdAt])
  @@index([assignedAdminId])
  @@index([createdAt])
  @@index([initiatorUserId])
  @@map("disputes")
}

model MutualResolutionProposal {
  id        String  @id @default(cuid())
  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  proposedBy   String
  proposer     User      @relation("MutualResolutionProposer", fields: [proposedBy], references: [id], onDelete: Restrict)
  proposerRole ActorType

  buyerPercent  Int
  sellerPercent Int
  reason        String @db.Text

  status       String    @default("PENDING") // PENDING | ACCEPTED | REJECTED | EXPIRED
  respondedAt  DateTime?
  responseNote String?   @db.Text

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@index([disputeId, status])
  @@map("mutual_resolution_proposals")
}

model DisputeEvidence {
  id        String  @id @default(cuid())
  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  // User? FK. Ini menyebabkan FK VIOLATION di PostgreSQL saat admin submit evidence,
  // karena AdminUser.id bukan User.id. Fix: pisah menjadi dua FK nullable yang terpisah.
  //
  // Aturan:
  //   - submittedByRole IN (BUYER, SELLER) → submittedByUserId wajib diisi, submittedByAdminId NULL
  //   - submittedByRole = ADMIN            → submittedByAdminId wajib diisi, submittedByUserId NULL
  //   - submittedByRole = SYSTEM           → keduanya NULL (pesan sistem otomatis)
  //
  // Check constraint via raw migration:
  // ALTER TABLE dispute_evidences ADD CONSTRAINT evidence_submitter_xor
  //   CHECK (
  //     (submitted_by_role IN ('BUYER', 'SELLER') AND submitted_by_user_id IS NOT NULL AND submitted_by_admin_id IS NULL) OR
  //     (submitted_by_role = 'ADMIN'              AND submitted_by_admin_id IS NOT NULL AND submitted_by_user_id IS NULL) OR
  //     (submitted_by_role = 'SYSTEM'             AND submitted_by_user_id IS NULL AND submitted_by_admin_id IS NULL)
  //   );

  submittedByRole ActorType // BUYER | SELLER | ADMIN | SYSTEM

  submittedByUserId String?
  submittedByUser   User?   @relation("DisputeEvidenceSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  submittedByAdminId String?
  submittedByAdmin   AdminUser? @relation("DisputeEvidenceAdmin", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  description String   @db.Text
  fileUrls    String[] // Array URL bukti (parallel array dengan fileTypes — harus sama panjang)
  fileTypes   String[] // Valid values per elemen: "image" | "document" | "screenshot"
  // Validated in application layer; enforced via DB constraint below
  // ALTER TABLE dispute_evidences ADD CONSTRAINT evidence_files_length
  //   CHECK (array_length(file_urls, 1) = array_length(file_types, 1));
  // Atau pertimbangkan migrasi ke model DisputeEvidenceFile tersendiri
  // jika query per-file menjadi kebutuhan.

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@index([createdAt]) // evidence list sorted by submission date
  @@index([submittedByUserId])
  @@index([submittedByAdminId])
  @@map("dispute_evidences")
}

model DisputeDecision {
  id        String  @id @default(cuid())
  disputeId String  @unique
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  decidedBy String
  decider   AdminUser @relation("DisputeDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  decisionType DisputeDecisionType

  // Split amounts (in sen)
  buyerAmount  BigInt
  sellerAmount BigInt
  // Tidak bisa dilakukan murni di DB tanpa join ke orders.escrow_balance,
  // sehingga WAJIB divalidasi di application layer (DisputeService.executeDecision):
  // assert buyerAmount + sellerAmount == order.orderValue
  // Partial DB constraint untuk minimal non-negative:
  // ALTER TABLE dispute_decisions ADD CONSTRAINT decision_amounts_non_negative
  //   CHECK (buyer_amount >= 0 AND seller_amount >= 0);

  // Percentages for SPLIT type
  // ALTER TABLE dispute_decisions ADD CONSTRAINT split_percent_sum
  //   CHECK (
  //     (buyer_percent IS NULL AND seller_percent IS NULL) OR
  //     (buyer_percent + seller_percent = 100)
  //   );
  // Tambah range check INDIVIDUAL untuk masing-masing kolom:
  // ALTER TABLE dispute_decisions ADD CONSTRAINT split_buyer_percent_range
  //   CHECK (buyer_percent IS NULL OR (buyer_percent BETWEEN 0 AND 100));
  // ALTER TABLE dispute_decisions ADD CONSTRAINT split_seller_percent_range
  //   CHECK (seller_percent IS NULL OR (seller_percent BETWEEN 0 AND 100));
  buyerPercent  Decimal? @db.Decimal(5, 2)
  sellerPercent Decimal? @db.Decimal(5, 2)

  decisionNotes String    @db.Text // Min 100 karakter — enforce di application layer
  isExecuted    Boolean   @default(false)
  executedAt    DateTime?

  timeToFirstResponseMs BigInt?
  totalResolutionTimeMs BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([decidedBy]) // index untuk admin decision lookup
  @@index([createdAt]) // reporting queries sorted by decision date
  @@map("dispute_decisions")
}

// ============================================================
// RATINGS
// ============================================================

model Rating {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  giverId    String
  giver      User   @relation("RatingGiver", fields: [giverId], references: [id], onDelete: Restrict)
  receiverId String
  receiver   User   @relation("RatingReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  stars     Int // 1-5
  // Check constraint via raw migration:
  // ALTER TABLE ratings ADD CONSTRAINT rating_stars_range
  //   CHECK (stars BETWEEN 1 AND 5);
  comment   String?  @db.VarChar(500)
  giverRole UserRole // Menggantikan String — BUYER atau SELLER

  isHidden Boolean   @default(false)
  hiddenAt DateTime?
  hiddenBy String? // Admin ID (soft FK ke admin_users.id)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reply RatingReply?

  @@unique([orderId, giverId])
  @@index([receiverId])
  @@index([receiverId, isHidden, createdAt]) // query "rating visible user X" (WHERE isHidden=false ORDER BY createdAt DESC)
  @@index([giverId])
  @@index([orderId])
  @@index([createdAt]) // query GET /users/:username/ratings sorted by date
  @@map("ratings")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id      String @id @default(cuid())
  // Format lama mengekspos userId ke client (notifId dikirim via API pada setiap notifikasi),
  // memungkinkan enumerasi userId dari notifId. Gunakan random segment (cuid/nanoid).
  notifId String @unique // Format: NTF-{timestamp}-{randomId}
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  category  NotificationCategory @default(INFORMASI)
  channel   NotificationChannel  @default(IN_APP)
  title     String
  body      String               @db.Text
  actionUrl String?

  isRead     Boolean   @default(false)
  readAt     DateTime?
  isSent     Boolean   @default(false)
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?

  refType  String?
  refId    String?
  metadata Json?

  createdAt DateTime  @default(now())
  expiresAt DateTime?
  deletedAt DateTime?

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, category, isRead])
  @@index([refId, refType])
  @@index([expiresAt])
  @@index([sentAt])
  @@index([deletedAt])
  @@map("notifications")
}

// ============================================================
// VOUCHERS
// ============================================================

model Voucher {
  id          String  @id @default(cuid())
  voucherId   String  @unique // Format: VCH-KODE
  code        String  @unique
  name        String
  description String?

  voucherType     VoucherType
  discountAmount  BigInt?
  discountPercent Decimal?    @db.Decimal(5, 2)
  // ALTER TABLE vouchers ADD CONSTRAINT voucher_discount_percent_range
  //   CHECK (discount_percent IS NULL OR (discount_percent > 0 AND discount_percent <= 100));
  // ALTER TABLE vouchers ADD CONSTRAINT voucher_discount_xor
  //   CHECK (
  //     fee-voucher types keep the legacy amount-vs-percent XOR, while
  //     WALLET_CASHBACK/TOPUP_BONUS also require exactly one benefit source
  //     and are credited later by their respective settlement hooks.
  //   );

  maxDiscountAmount BigInt?
  maxUsageTotal     Int?
  maxUsagePerUser   Int     @default(1)
  // ALTER TABLE vouchers ADD CONSTRAINT voucher_usage_per_user_valid
  //   CHECK (max_usage_per_user >= 1);
  currentUsage      Int     @default(0)

  // Validity
  isActive   Boolean  @default(true)
  validFrom  DateTime
  validUntil DateTime
  // ALTER TABLE vouchers ADD CONSTRAINT voucher_validity_range
  //   CHECK (valid_until > valid_from);

  // Conditions
  minOrderValue BigInt?
  // NULL sebelumnya bisa diinterpretasi sebagai "tidak ada kondisi" (= ALL).
  // Lebih eksplisit menggunakan @default(ALL).
  applicableTo  VoucherApplicability @default(ALL)

  // Tracking
  createdBy        String // Admin ID (soft FK ke admin_users.id) atau SYSTEM_* untuk otomasi promo
  // FK ke campaigns.id untuk tracing voucher yang diterbitkan scheduler campaign.
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Soft FK ke users.id untuk voucher personal; NULL berarti voucher publik.
  assignedToUserId String?
  deactivatedBy    String? // Admin ID (soft FK ke admin_users.id)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deactivatedAt    DateTime?

  usages VoucherUsage[]
  orders Order[]

  @@unique([campaignId, assignedToUserId]) // idempotensi issuer campaign per user; NULL tetap boleh untuk voucher publik
  @@index([isActive, validUntil])
  @@index([isActive, validFrom, validUntil]) // Compound untuk "valid sekarang?"
  @@index([isActive]) // standalone index untuk voucher aktif
  @@index([createdBy]) // index untuk admin voucher lookup
  @@index([campaignId]) // tracing voucher hasil campaign tanpa hard FK
  @@index([assignedToUserId, isActive, validUntil]) // list voucher personal user
  @@map("vouchers")
}

model VoucherUsage {
  id          String              @id @default(cuid())
  voucherId   String
  voucher     Voucher             @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Satu usage berasal dari order ATAU top-up; constraint XOR ada di migration.
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentTxId String?
  paymentTx   PaymentTransaction? @relation(fields: [paymentTxId], references: [id], onDelete: Restrict)

  discountApplied BigInt
  usedAt          DateTime @default(now())

  @@unique([voucherId, userId, orderId])
  @@unique([voucherId, userId, paymentTxId]) // idempotensi usage voucher top-up per payment transaction
  @@index([voucherId])
  @@index([userId])
  @@index([orderId])
  @@index([paymentTxId])
  @@index([voucherId, userId])
  @@map("voucher_usages")
}

// ============================================================
// REFERRAL
// ============================================================

model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code              String  @unique
  isActive          Boolean @default(true)
  totalReferrals    Int     @default(0) // Denormalized counter — sync via ReferralService
  totalRewardEarned BigInt  @default(0) // Denormalized counter — sync via ReferralService
  // ALTER TABLE referral_codes ADD CONSTRAINT referral_code_counters_non_negative
  //   CHECK (total_referrals >= 0 AND total_reward_earned >= 0);
  // TIDAK disimpan di DB — harus di-compute di service layer:
  //   COUNT(*) FROM referral_rewards WHERE referrer_id = ? AND is_credited = false

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relations ReferralRelation[] @relation("ReferralCodeRelation")

  @@map("referral_codes")
}

model ReferralRelation {
  id             String       @id @default(cuid())
  referralCodeId String
  referralCode   ReferralCode @relation("ReferralCodeRelation", fields: [referralCodeId], references: [id], onDelete: Restrict)

  referrerId String
  referrer   User   @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Restrict)
  refereeId  String @unique // Satu user hanya bisa direferral sekali
  referee    User   @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Restrict)
  // ALTER TABLE referral_relations ADD CONSTRAINT referral_no_self
  //   CHECK (referrer_id != referee_id);

  isReferrerKyc  Boolean @default(false)
  isRefereeKyc   Boolean @default(false)
  isRewardActive Boolean @default(false)

  appliedAt         DateTime  @default(now())
  rewardActivatedAt DateTime?

  // Flag review manual bila referrer memperoleh >=5 relasi baru dalam 24 jam.
  flaggedForReview   Boolean   @default(false)
  flaggedForReviewAt DateTime?
  reviewReason       String?

  rewards ReferralReward[]

  @@index([referralCodeId])
  @@index([referrerId])
  @@index([referrerId, appliedAt]) // deteksi lonjakan referral 24 jam
  @@index([flaggedForReview]) // antrean review admin referral
  @@map("referral_relations")
}

model ReferralReward {
  id                 String           @id @default(cuid())
  relationId         String
  relation           ReferralRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  referrerId         String
  referrer           User             @relation(fields: [referrerId], references: [id], onDelete: Restrict)
  triggeredByOrderId String
  triggeredByOrder   Order            @relation(fields: [triggeredByOrderId], references: [id], onDelete: Restrict)

  feeAmount    BigInt
  rewardAmount BigInt
  isCredited   Boolean   @default(false)
  creditedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([triggeredByOrderId, referrerId])
  @@index([relationId])
  @@index([referrerId])
  @@index([referrerId, isCredited])
  @@map("referral_rewards")
}

// ============================================================
// SUBSCRIPTIONS (Kahade Plus)
// ============================================================

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(PENDING)

  price         BigInt // Harga dibayar setelah promo/trial (dalam sen)
  // Harga katalog sebelum promo periode pertama; NULL untuk legacy/tanpa promo.
  originalPrice BigInt?

  // Trial 1x seumur user; scheduler expiry membaca currentPeriodEnd yang sama dengan trialEndsAt.
  trialEndsAt DateTime?

  // Pause sementara: entitlement dicabut sampai resumeAt, lalu auto-resume via scheduler.
  pausedAt DateTime?
  resumeAt DateTime?

  // Di-set atomis saat subscription berhasil diaktifkan oleh SubscriptionService.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // ALTER TABLE subscriptions ADD CONSTRAINT subscription_period_valid
  //   CHECK (
  //     (current_period_start IS NULL AND current_period_end IS NULL) OR
  //     (current_period_end > current_period_start)
  //   );

  isAutoRenew  Boolean   @default(false)
  cancelledAt  DateTime?
  cancelReason String?

  paymentMethod   PaymentMethod?
  paymentTxId     String?
  paymentTx       PaymentTransaction? @relation(fields: [paymentTxId], references: [id], onDelete: SetNull)
  // API GET /subscriptions/history (14.5) harus menggunakan field ini (lastPaymentAt),
  // bukan "paymentAt" yang tidak ada di schema. Sudah difix di API v2.4.
  lastPaymentAt   DateTime?
  nextPaymentAt   DateTime?
  paymentFailedAt DateTime?

  feeSavingsUsed  BigInt @default(0)
  feeSavingsLimit BigInt @default(500000000) // Rp 5.000.000 dalam sen
  // ALTER TABLE subscriptions ADD CONSTRAINT subscription_savings_valid
  //   CHECK (fee_savings_used >= 0 AND fee_savings_limit >= 0
  //     AND fee_savings_used <= fee_savings_limit);
  // feeSavingsRemaining TIDAK disimpan di DB — computed di service layer:
  // feeSavingsRemaining = feeSavingsLimit - feeSavingsUsed
  // Dikembalikan di API GET /subscriptions/status sebagai convenience field.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hanya 1 ACTIVE subscription per user — enforce via raw migration:
  // CREATE UNIQUE INDEX sub_one_active_per_user ON subscriptions(user_id)
  // WHERE status = 'ACTIVE';

  @@index([userId])
  @@index([status])
  @@index([userId, status]) // compound untuk query "apakah user X punya active subscription?"
  @@index([paymentTxId]) // webhook lookup "find subscription by payment"
  @@index([nextPaymentAt]) // [M-02] auto-renewal cron: base index untuk nextPaymentAt filter
  @@index([status, resumeAt]) // auto-resume subscription PAUSED yang jatuh tempo
  @@index([userId, trialEndsAt]) // validasi trial 1x seumur user
  @@index([status, isAutoRenew, nextPaymentAt])
  // WHERE status='ACTIVE' AND is_auto_renew=true AND next_payment_at<=now()
  @@map("subscriptions")
}

// ============================================================
// MEMBERSHIP
// ============================================================

model MembershipRankHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fromRank MembershipRank?
  toRank   MembershipRank
  reason   String?

  // Snapshot saat naik rank
  totalOrders   Int
  totalValue    BigInt
  // ALTER TABLE membership_rank_histories ADD CONSTRAINT avg_rating_range
  //   CHECK (average_rating BETWEEN 0 AND 5);
  averageRating Decimal @db.Decimal(3, 2)
  memberDays    Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt]) // query "riwayat rank terbaru user X" ORDER BY createdAt DESC
  @@map("membership_rank_histories")
}

// ============================================================
// SOCIAL: BLOCK & REPORT
// ============================================================

model Follow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model UserLink {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

