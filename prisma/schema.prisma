// ============================================================
// USERS
// ============================================================

model User {
  id          String          @id @default(cuid())
  userId      String          @unique // Format: USR-XXXXXXXX
  username    String?         @unique
  email       String?         @unique
  password    String?

  // Profile
  fullName    String
  bio         String?         @db.VarChar(500)
  avatarUrl   String?
  headerUrl   String?
  accountType UserAccountType @default(PERSONAL)
  usernameChangedAt DateTime?

  // Extended profile (collected at registration)
  phoneNumber     String    @unique
  phoneNumberHash String?   @unique
  phoneVerified   Boolean   @default(false)
  dateOfBirth     DateTime? @db.Date
  gender          Gender?
  address         String?   @db.VarChar(500)

  // Verification
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // kycStatus denormalized — query cepat tanpa JOIN ke kyc_requests
  // Di-sync oleh KycService saat approve/reject/revoke
  kycStatus     KycStatus @default(UNVERIFIED)
  kycApprovedAt DateTime?

  // Kahade Plus flag denormalized — di-sync oleh SubscriptionService
  isKahadePlus          Boolean   @default(false)
  subscriptionExpiresAt DateTime?

  // Security
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime? // Account lockout
  lastLoginAt           DateTime?
  lastLoginIp           String?
  passwordChangedAt     DateTime?
  isActive              Boolean   @default(true)
  isBanned              Boolean   @default(false)
  banReason             String?
  bannedAt              DateTime?
  bannedBy              String?   // Admin user ID (soft FK ke admin_users.id)

  // Contact options
  contactEmail          String?
  contactPhone          String?
  showContactEmail      Boolean   @default(false)
  showContactPhone      Boolean   @default(false)

  // Privacy and localization settings persisted in DB (Redis used as read-through cache)
  profileVisible        Boolean   @default(true)
  showOnlineStatus      Boolean   @default(true)
  language              String    @default("id")

  // Flags
  isVip                 Boolean   @default(false)  // Badge VIP dari admin
  vipGrantedAt          DateTime?
  vipGrantedBy          String?   // Admin user ID (soft FK ke admin_users.id)

  // Membership
  membershipRank        MembershipRank @default(BRONZE)
  rankUpdatedAt         DateTime       @default(now())

  // Stats (denormalized for performance)
  // ALTER TABLE users ADD CONSTRAINT user_stats_non_negative
  //   CHECK (
  //     total_orders_completed >= 0 AND
  //     total_transaction_value >= 0 AND
  //     average_rating BETWEEN 0 AND 5 AND
  //     total_rating_count >= 0
  //   );
  totalOrdersCompleted  Int     @default(0)
  totalOrdersAsBuyer    Int     @default(0) // Denormalized counter — updated by OrderStateService
  totalOrdersAsSeller   Int     @default(0) // Denormalized counter — updated by OrderStateService
  totalOrdersCancelled  Int     @default(0) // Check constraint via migration (>= 0)
  totalOrdersDisputed   Int     @default(0) // Check constraint via migration (>= 0)
  totalTransactionValue BigInt  @default(0) // dalam satuan SEN (IDR x 100) — konsisten dengan wallet
  averageRating         Decimal @default(0) @db.Decimal(3, 2)
  totalRatingCount      Int     @default(0)
  memberSince           DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  sessions                UserSession[]
  devices                 UserDevice[]
  twoFactorAuth           TwoFactorAuth?
  otpCodes                OtpCode[]
  kycRequests             KycRequest[]
  bankAccounts            BankAccount[]
  wallet                  Wallet?
  ordersAsBuyer           Order[]               @relation("BuyerOrders")
  ordersAsSeller          Order[]               @relation("SellerOrders")
  chatMessages            ChatMessage[]
  ratingsGiven            Rating[]              @relation("RatingGiver")
  ratingsReceived         Rating[]              @relation("RatingReceiver")
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  voucherUsages           VoucherUsage[]
  referralCode            ReferralCode?
  referralUsed            ReferralRelation?     @relation("RefereeUser")    // fix typo: ReferreeUser → RefereeUser
  referralsGiven          ReferralRelation[]    @relation("ReferrerUser")
  referralRewards         ReferralReward[]
  subscriptions           Subscription[]
  membershipRankHistories MembershipRankHistory[]
  blockedUsers            BlockList[]           @relation("BlockerUser")
  blockedByUsers          BlockList[]           @relation("BlockedUser")
  reportsSubmitted        UserReport[]          @relation("ReportSubmitter")
  reportsReceived         UserReport[]          @relation("ReportTarget")
  auditLogs               AuditLog[]
  paymentTransactions     PaymentTransaction[]
  initiatedDisputes       Dispute[]             @relation("DisputeInitiatorUser")
  requestedDisputeCalls   DisputeCall[]         @relation("DisputeCallRequester")
  disputeMessages         DisputeMessage[]      @relation("DisputeMessageSender")
 
  disputeEvidences        DisputeEvidence[]     @relation("DisputeEvidenceSubmitter")
  mutualResolutionProposals MutualResolutionProposal[] @relation("MutualResolutionProposer")
 
  extensionRequests       OrderExtensionRequest[] @relation("ExtensionRequester")
  extensionResponses      OrderExtensionRequest[] @relation("ExtensionResponder")
  // Badge system — reverse relations untuk UserBadge
  badges                  UserBadge[]
  // Password history — untuk cegah password cycling
  passwordHistories       PasswordHistory[]
  // Social links
  links                   UserLink[]
  // Follow system
  followers               Follow[]              @relation("FollowingUser")
  following               Follow[]              @relation("FollowerUser")
  // Favorites system
  favoritesGiven          UserFavorite[]        @relation("FavoriteOwner")
  favoritesReceived       UserFavorite[]        @relation("FavoriteTarget")
  // Saved-profile system, intentionally separate from favorites
  savedProfilesGiven      UserSavedProfile[]    @relation("SavedProfileOwner")
  savedProfilesReceived   UserSavedProfile[]    @relation("SavedProfileTarget")
  // Order links
  orderLinksCreated       OrderLink[]           @relation("OrderLinkCreator")
  // Profile Q&A
  questionsAsked          ProfileQuestion[]     @relation("QuestionAsker")
  questionsReceived       ProfileQuestion[]     @relation("QuestionReceiver")
  questionComments        ProfileQuestionComment[] @relation("CommentAuthor")
  supportTickets          SupportTicket[]          @relation("UserSupportTickets")
  showcaseItems           UserShowcase[]
  scheduledWithdrawals    ScheduledWithdrawal[]  @relation("UserScheduledWithdrawals")
  deliveryProofsSubmitted DeliveryProof[]        @relation("DeliveryProofSubmitter")
  ratingReplies           RatingReply[]          @relation("RatingReplies")
  orderLinksAccepted      OrderLink[]            @relation("OrderLinkAcceptor")
  transactionTemplates    TransactionTemplate[]  @relation("UserTransactionTemplates")
  idempotencyRecords       IdempotencyRecord[]

  //         — ketiga field ini sudah @unique, index dibuat otomatis. Redundan.
  @@index([kycStatus])
  @@index([membershipRank])
  @@index([createdAt])
  @@index([isActive, isBanned])
  @@index([deletedAt]) // WHERE deletedAt IS NULL query optimization
  @@map("users")
}

// ============================================================
// AUTH & SESSION
// ============================================================

model UserSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jti           String   @unique // JWT ID — untuk blacklist token
  refreshToken  String   @unique // Hashed refresh token
  deviceId      String?  // Stable app-generated device identifier
  deviceInfo    String?  // User-Agent
  ipAddress     String
  isRevoked     Boolean  @default(false)
  revokedAt     DateTime?
  revokedReason String?  // logout, password_change, admin_revoke, etc.

  lastActiveAt  DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, deviceId])
  @@index([userId, isRevoked]) // query "sesi aktif user X" (WHERE isRevoked=false)
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId       String   // Fingerprint
  deviceName     String?  // "Chrome on MacOS"
  deviceType     String?  // "desktop", "mobile", "tablet"
  os             String?
  browser        String?
  // Separate pushToken field from deviceId to avoid conflating
  // push notification tokens with browser/device fingerprints
  pushToken      String?
  ipAddress      String
  isTrusted      Boolean  @default(false)
  trustedAt      DateTime?
  lastLoginAt    DateTime @default(now())
  loginCount     Int      @default(1)
  createdAt      DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])          // cross-user device detection lookup
  @@index([pushToken])        
  @@map("user_devices")
}

model TwoFactorAuth {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret        String?   // TOTP secret (encrypted AES-256), null saat 2FA dinonaktifkan
  isEnabled     Boolean   @default(false)
  enabledAt     DateTime?
  disabledAt    DateTime?
  backupCodes   String[]  // Hashed backup codes (10 kode)
  usedBackupCodes String[] @default([])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("two_factor_auth")
}

model OtpCode {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String?
  phone       String?
  code        String
  type        OtpType
  method      OtpMethod?
  metadata    Json?

  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  attempts    Int      @default(0)
  ipAddress   String?

  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([email, type])
  @@index([phone, type])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, type, isUsed])
  @@map("otp_codes")
}

