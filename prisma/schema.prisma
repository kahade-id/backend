  userId         String
  user           User   @relation("FavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  favoriteUserId String
  favoriteUser   User   @relation("FavoriteTarget", fields: [favoriteUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, favoriteUserId])
  @@index([userId])
  @@index([favoriteUserId])
  @@map("user_favorites")
}

model UserSavedProfile {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation("SavedProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  savedUserId String
  savedUser   User   @relation("SavedProfileTarget", fields: [savedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, savedUserId])
  @@index([userId, createdAt])
  @@index([savedUserId])
  @@map("user_saved_profiles")
}

model UserReport {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Restrict)
  targetId   String
  target     User   @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Restrict)

  category     ReportCategory
  description  String         @db.VarChar(500)
  evidenceUrls String[]

  relatedOrderId   String?
  relatedMessageId String? // Soft FK ke chat_messages.id — tidak ada FK constraint karena pesan bisa dihapus

  status     ReportStatus @default(PENDING)
  reviewedBy String? // Admin ID (soft FK ke admin_users.id)
  reviewedAt DateTime?
  resolution String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([targetId])
  @@index([status])
  @@index([status, createdAt]) // admin report queue: status-filter + sort by date
  @@index([createdAt]) // admin queue sorted by date
  @@index([relatedOrderId])
  @@index([reviewedBy]) // index untuk admin review lookup
  @@map("user_reports")
}

// ============================================================
// BADGES (Achievement system)
