  createdAt   DateTime @default(now())

  @@index([disputeId])
  @@index([disputeId, createdAt])
  @@index([adminId])
  @@map("dispute_messages")
}

model UserShowcase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  imageUrl    String?
  priceMin    BigInt?
  priceMax    BigInt?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive, sortOrder])
  @@map("user_showcases")
}

enum DisputeCallStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  ENDED
  REJECTED
  EXPIRED
}

model DisputeCall {
  id              String            @id @default(cuid())
  disputeId       String
  dispute         Dispute           @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  requestedById   String
  requestedBy     User              @relation("DisputeCallRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  status          DisputeCallStatus @default(REQUESTED)

  requestedAt     DateTime          @default(now())
  acceptedAt      DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  maxDurationSeconds Int            @default(900)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([disputeId])
  @@index([disputeId, status])
  @@index([requestedById])
  @@map("dispute_calls")
}


enum IdempotencyRecordStatus {
  IN_FLIGHT
  COMPLETED
}

model IdempotencyRecord {
  id            String                 @id @default(cuid())
  userId        String?
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String
  // SHA-256 of the canonical request body; reusing a key with a different payload is rejected.
  requestHash   String?
  // Includes HTTP method + route + user scope + key to prevent cross-endpoint replay.
  scopeKey      String                 @unique
  status        IdempotencyRecordStatus @default(IN_FLIGHT)
  responseBody  Json?
  statusCode    Int                    @default(200)
  errorMessage  String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  completedAt   DateTime?
  expiresAt     DateTime

  @@index([userId, key])
  @@index([expiresAt])
  @@index([status, expiresAt])
  @@map("idempotency_records")
}
