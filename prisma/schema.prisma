  orderEmail     Boolean @default(true)
  walletInApp    Boolean @default(true)
  walletPush     Boolean @default(true)
  walletEmail    Boolean @default(true)
  securityInApp  Boolean @default(true)
  securityPush   Boolean @default(true)
