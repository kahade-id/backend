  // ORDER BY flaggedForReviewAt DESC. Selektivitasnya tinggi (hanya sedikit
  // user yang pernah terflag) sehingga index boolean ini efektif.
  @@index([flaggedForReview, flaggedForReviewAt])
  @@map("users")
