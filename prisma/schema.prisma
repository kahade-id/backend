  @@map("feedback_sla_rules")
}

// === GAP-C: Order escrow bertahap/milestone (G176–G200) ===
// EKSTENSI produk: order satu tahap existing TIDAK berubah perilaku.
// Escrow per milestone dialokasikan dari escrowBalance wallet buyer;
// OrderMilestone.escrowHeld mencatat porsi tiap tahap (invariant:
// sum(escrowHeld) + sum(released buyerAmount) = buyerPayAmount utk order milestone).

enum MilestoneStatus {
  DRAFT
  AWAITING_ACTIVATION
  SUBMITTED
  REVISION_REQUESTED
  ACCEPTED
  RELEASED
  CANCELLED
  DISPUTED
}

enum MilestoneEventType {
  CREATED
  UPDATED
  ACTIVATED
  SUBMITTED
  REVISION_REQUESTED
  ACCEPTED
  RELEASED
  DEADLINE_EXTENDED
  CANCELLED
  DISPUTE_OPENED
  DISPUTE_CLOSED
  REMINDER_SENT
  CHANGE_REQUESTED
  CHANGE_APPROVED
}

enum MilestoneActorType {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

model OrderMilestone {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq     Int

  title        String  @db.VarChar(120)
  description  String? @db.Text
  /// Nilai tahap — bagian dari Order.orderValue. Sum(amount) per order HARUS
  /// = orderValue (divalidasi di service dalam transaksi + alat rekonsiliasi).
  amount       BigInt
  /// Bagian sellerReceiveAmount untuk tahap ini (proporsional, tahap terakhir
  /// menyerap sisa pembulatan). Sum(sellerAmount) = sellerReceiveAmount.
  sellerAmount BigInt
  /// Bagian buyerPayAmount untuk tahap ini (proporsional, tahap terakhir
  /// menyerap sisa). Sum(buyerAmount) = buyerPayAmount.
  buyerAmount  BigInt
  /// Fee platform tahap ini = buyerAmount - sellerAmount (G187).
  /// Sum(feeAmount) = feeAmount order.
  feeAmount    BigInt

  status         MilestoneStatus @default(DRAFT)
  deadline       DateTime?
  reviewDeadline DateTime?

  submittedAt   DateTime?
  submittedById String?
  acceptedAt    DateTime?
  releasedAt    DateTime?
  /// WalletTransaction.id dari MILESTONE_RELEASE — kunci idempotensi release.
  releasedTxId  String?   @unique

  revisionRounds    Int @default(0)
  maxRevisionRounds Int @default(2)

  /// Porsi escrow buyer yang ditahan untuk tahap ini (dalam satuan sen).
  escrowHeld BigInt @default(0)

  /// Perubahan pasca-bayar butuh persetujuan dua pihak (G179).
  changeRequest        Json?
  buyerApprovedChange  Boolean @default(false)
  sellerApprovedChange Boolean @default(false)

  evidence MilestoneEvidence[]
  events   MilestoneEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, seq])
  @@index([orderId, status])
  @@map("order_milestones")
}

model MilestoneEvidence {
  id           String         @id @default(cuid())
  milestoneId  String
  milestone    OrderMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileKey      String         @db.VarChar(500)
  fileType     String?        @db.VarChar(80)
  caption      String?        @db.VarChar(280)
  uploadedById String
  createdAt    DateTime       @default(now())

  @@index([milestoneId, createdAt])
  @@map("milestone_evidence")
}

model MilestoneEvent {
  id          String             @id @default(cuid())
  milestoneId String
  milestone   OrderMilestone     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actorType   MilestoneActorType
  actorId     String?
  eventType   MilestoneEventType
  payload     Json?
  createdAt   DateTime           @default(now())

  @@index([milestoneId, createdAt])
  @@index([eventType, createdAt])
  @@map("milestone_events")
}

// === GAP-A: social-login (G001–G025) ===
// Relasi provider-subject yang stabil; email TIDAK dijadikan satu-satunya
// identitas eksternal (G012). Consent dicatat saat penautan pertama (G020).
enum SocialProvider {
  GOOGLE
  APPLE
}

model SocialAccount {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           SocialProvider
  providerSub        String
  email              String?
  linkedAt           DateTime       @default(now())
  lastUsedAt         DateTime?
  consentAt          DateTime?
  consentTextVersion String?

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("social_accounts")
}

// === GAP-A: account deletion lifecycle (G051–G075) ===
// Append-only, 2026-09-27. Mencerminkan migration
// 20260927030100_gap_account_deletion (tabel dibuat di sana; model ini
// ditambahkan agar Prisma Client mengenalinya).

enum DeletionRequestStatus {
  // Permintaan dibuat; masa tenggang 30 hari berjalan (satu-satunya status
  // awal yang diproduksi kode saat ini — default kolom `status`).
  REQUESTED
  // Dipesan untuk kompatibilitas maju: diperlakukan sebagai "aktif" di semua
  // filter (ACTIVE_DELETION_STATUSES), tetapi TIDAK ADA jalur kode yang
  // menghasilkannya per 2026-09-27. Jangan mengasumsikan request PENDING ada.
  PENDING
  CANCELLED
  PURGED
  ON_HOLD
}

model AccountDeletionRequest {
  id              String                         @id @default(cuid())
  userId          String
  user            User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceCode   String                         @unique
  status          DeletionRequestStatus          @default(REQUESTED)
  idempotencyKey  String                         @unique
  requestedAt     DateTime                       @default(now())
  purgeAt         DateTime
  cancelledAt     DateTime?
  cancelReason    String?
  purgedAt        DateTime?
  legalHoldReason String?
  reminder7dSent  Boolean                        @default(false)
  reminder1dSent  Boolean                        @default(false)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  history         AccountDeletionStatusHistory[]

  @@index([userId, status])
  @@index([status, purgeAt])
  @@map("account_deletion_requests")
}

model AccountDeletionStatusHistory {
  id          String                 @id @default(cuid())
  requestId   String
  request     AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  DeletionRequestStatus?
  toStatus    DeletionRequestStatus
  actorUserId String?
  actorType   String                 @db.VarChar(16)
  reason      String?                @db.VarChar(500)
  createdAt   DateTime               @default(now())

  @@index([requestId, createdAt])
  @@map("account_deletion_status_history")
}

// === GAP-F: moderation lifecycle (G401–G425) + Q&A moderation (G426–G450) + partner API (G451–G475) ===
// Append-only, 2026-09-26. Relasi balik & kolom aditif ditambahkan ke model existing di bawah.

// === GAP-F: ModerationEventAction ===
// Aksi dalam lifecycle moderasi laporan etalase. Setiap aksi (termasuk review
// awal) WAJIB menulis satu baris ReportModerationEvent — append-only (G403).
enum ModerationEventAction {
  REOPENED
  NOTE_ADDED
  APPEAL_FILED
  APPEAL_DECIDED
  RESTORED
  RESTRICTED
  TAKEDOWN
  ASSIGNED
  ESCALATED
  EXPORTED
  DISMISSED
  NO_ACTION
  UNDER_REVIEW
}

// === GAP-F: ModerationReasonCode ===
// Kode alasan moderasi terstandar (G412). Definisi tiap kode untuk moderator:
// fixes/docs/moderation-reason-codes.md
enum ModerationReasonCode {
  SPAM
  HARASSMENT
  FRAUD_SUSPECTED
  PROHIBITED_ITEM
  MISLEADING
  IP_VIOLATION
  NUDITY
  OTHER
}

// === GAP-F: AppealStatus ===
// Status banding atas keputusan moderasi (G404/G405).
enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

// === GAP-F: AppellantType ===
// Pihak yang mengajukan banding: OWNER (pemilik item) atau REPORTER (pelapor).
enum AppellantType {
  OWNER
  REPORTER
}

// === GAP-F: NotificationType additions ===
// MERGE: tambahkan tiga nilai berikut ke enum NotificationType yang sudah ada
// di schema.prisma (append-only — nilai existing tidak diubah):
//   MODERATION_REPORT_UPDATE  — status laporan berubah → notifikasi ke pelapor,
//                              tanpa identitas pemilik item (G416, privasi-aware).
//   MODERATION_ITEM_TAKEDOWN  — item di-takedown/dibatasi → notifikasi ke pemilik
//                              item + cara mengajukan banding (G417).
//   MODERATION_APPEAL_DECIDED — banding diputus → notifikasi ke pemilik item
//                              (dan pelapor bila relevan) (G405).
// Nilai-nilai ini dipakai di kode via string-cast agar tsc lolos sebelum
// `prisma generate`; runtime valid setelah migrasi SQL di-apply.

// === GAP-F: ReportModerationEvent ===
// Jejak audit append-only SEMUA aksi moderasi atas sebuah laporan (G403, G420).
// Ditulis oleh: review awal, reopen, catatan, assignment, restrict/restore,
// takedown, appeal, eskalasi SLA, export. TIDAK PERNAH di-update/di-delete
// oleh kode aplikasi (tidak ada endpoint mutasi selain create).
model ReportModerationEvent {
  id           String                @id @default(cuid())
  reportId     String
  report       ShowcaseReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorAdminId String? // Admin ID (soft FK ke admin_users.id, pola sama seperti ShowcaseReport.reviewedBy); null = aksi sistem/scheduler
  action       ModerationEventAction
  stateFrom    ReportStatus?
  stateTo      ReportStatus?
  reasonCode   ModerationReasonCode?
  note         String?               @db.Text
  metadata     Json? // snapshot item (G409), slaDueAt, restrictUntil, export filter, dsb.
  createdAt    DateTime              @default(now())

  @@index([reportId, createdAt])
  @@index([actorAdminId, createdAt])
  @@map("report_moderation_events")
}

// === GAP-F: ReportAppeal ===
// Banding atas keputusan moderasi final (G404/G405). Diajukan pemilik item
// atas takedown (alasan + bukti baru WAJIB); dibedakan dari laporan baru —
// laporan baru atas item yang sudah takedown → 409 dengan arahan ke appeal.
model ReportAppeal {
  id              String         @id @default(cuid())
  reportId        String
  report          ShowcaseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  appellantType   AppellantType
  appellantUserId String // userId pemilik/pelapor (soft FK ke users.id)
  reason          String         @db.Text
  newEvidence     Json // bukti baru wajib (keys/files) — G404
  status          AppealStatus   @default(PENDING)
  reviewerAdminId String? // soft FK admin_users.id; WAJIB != report.reviewedBy (G406)
  decidedAt       DateTime?
  decisionNote    String?        @db.Text // wajib saat decide (G422)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([reportId, status])
  @@index([status, createdAt])
  @@map("report_appeals")
}

// === GAP-F: ReportCluster ===
// Cluster laporan duplikat: laporan baru dengan showcaseId+reason sama dalam
// 24 jam ditautkan ke cluster yang sama (G415). Laporan sumber TIDAK dihapus —
// cluster hanya menautkan.
model ReportCluster {
  id          String                @id @default(cuid())
  showcaseId  String
  reason      String                @db.VarChar(100)
  reportCount Int                   @default(0)
  createdAt   DateTime              @default(now())
  members     ReportClusterMember[]

  @@index([showcaseId, createdAt])
  @@map("report_clusters")
}

// === GAP-F: ReportClusterMember ===
// Join table keanggotaan cluster (menghindari kolom baru di ShowcaseReport).
model ReportClusterMember {
  id        String         @id @default(cuid())
  clusterId String
  cluster   ReportCluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  reportId  String
  report    ShowcaseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([clusterId, reportId])
  @@index([reportId])
  @@map("report_cluster_members")
}

// === GAP-F: ReportAssignment ===
// Assignment laporan ke admin + skor risiko + SLA (G411, G419).
// Handoff = assignment baru (baris lama di-set unassignedAt; histori utuh).
model ReportAssignment {
  id              String         @id @default(cuid())
  reportId        String
  report          ShowcaseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  assigneeAdminId String // soft FK admin_users.id
  riskScore       Int // 0–100; >=70 = risiko tinggi (SLA 24 jam)
  slaDueAt        DateTime // dihitung saat assignment: 24 jam (risiko tinggi) / 72 jam (normal)
  escalated       Boolean        @default(false)
  assignedAt      DateTime       @default(now())
  unassignedAt    DateTime?
  createdAt       DateTime       @default(now())

  @@index([assigneeAdminId, slaDueAt])
  @@index([slaDueAt])
  @@map("report_assignments")
}

// === GAP-F: enum QaModerationReason ===
// Reason code MODERATOR platform (G429). Berbeda dari ContentHiddenReason milik
// self-service pemilik (SPAM|INAPPROPRIATE|HARASSMENT|OTHER): pemetaan ke kolom
// hidden_reason lama: SPAM→SPAM, PROFANITY→INAPPROPRIATE, HARASSMENT→HARASSMENT,
// PII_LEAK/SCAM_SUSPECTED/OFF_TOPIC/OTHER→OTHER. Kode presisi disimpan di
// qa_moderation_events.reason_code + qa_reports.reason_code.
enum QaModerationReason {
  SPAM
  PROFANITY
  HARASSMENT
  PII_LEAK
  SCAM_SUSPECTED
  OFF_TOPIC
  OTHER

  @@map("qa_moderation_reason")
}

// === GAP-F: enum QaHiddenByType ===
// G428 — membedakan hide self-service pemilik profil vs hide moderator platform.
enum QaHiddenByType {
  OWNER
  MODERATOR

  @@map("qa_hidden_by_type")
}

// === GAP-F: enum QaReportTarget ===
enum QaReportTarget {
  QUESTION
  COMMENT

  @@map("qa_report_target")
}

// === GAP-F: enum QaReportStatus ===
enum QaReportStatus {
  PENDING
  UNDER_REVIEW
  DISMISSED
  ACTION_TAKEN

  @@map("qa_report_status")
}

// === GAP-F: enum QaAppealStatus ===
enum QaAppealStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("qa_appeal_status")
}

// === GAP-F: enum QaEventAction ===
// G437 — append-only; tidak ada UPDATE/DELETE pada tabel ini.
enum QaEventAction {
  HIDDEN
  UNHIDDEN
  REDACTED
  DELETED
  APPEAL_SUBMITTED
  APPEAL_APPROVED
  APPEAL_REJECTED

  @@map("qa_event_action")
}

// === GAP-F: enum QaDeleteApprovalStatus ===
// G435 — hapus permanen dua langkah: request (SUPER_ADMIN) → approve
// (SUPER_ADMIN lain, ≠ requester).
enum QaDeleteApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("qa_delete_approval_status")
}

// === GAP-F: model QaReport ===
// G431 — laporan pengguna atas pertanyaan/komentar profil. Antrean TERPISAH
// dari laporan etalase (showcase_reports).
model QaReport {
  id         String         @id @default(cuid())
  targetType QaReportTarget @map("target_type")
  // targetId sengaja TANPA FK (String polos) supaya laporan tetap jadi audit
  // trail walau target dihapus permanen.
  targetId   String         @map("target_id")
  reporterId String         @map("reporter_id")
  reporter   User           @relation("QaReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reasonCode QaModerationReason @map("reason_code")
  note       String?            @db.VarChar(500)

  status QaReportStatus @default(PENDING)

  // G446 — assignment kasus + handoff antar moderator.
  assignedAdminId String?    @map("assigned_admin_id")
  assignedAdmin   AdminUser? @relation("QaReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by") // admin_users.id resolver (soft FK, audit)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([assignedAdminId])
  // Satu laporan TERBUKA per (pelapor, target): cegah duplikat spam laporan.
  // Ditegakkan sebagai partial unique index di migration SQL.
  @@map("qa_reports")
}

// === GAP-F: model QaAppeal ===
// G436 — keberatan penulis (asker/author) atau pemilik profil (receiver) atas
// hide MODERATOR. Reviewer wajib ≠ moderator yang melakukan hide (ditegakkan di
// service; constraint CHECK tidak bisa karena butuh join event).
model QaAppeal {
  id          String         @id @default(cuid())
  targetType  QaReportTarget @map("target_type")
  targetId    String         @map("target_id") // tanpa FK, alasan sama seperti QaReport
  appellantId String         @map("appellant_id")
  appellant   User           @relation("QaAppellant", fields: [appellantId], references: [id], onDelete: Cascade)

  reason String @db.VarChar(1000)

  status QaAppealStatus @default(PENDING)

  reviewerAdminId String?   @map("reviewer_admin_id") // admin_users.id (soft FK)
  reviewedAt      DateTime? @map("reviewed_at")
  reviewNote      String?   @map("review_note") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([targetType, targetId])
  @@index([status, createdAt])
  @@index([appellantId])
  @@map("qa_appeals")
}

// === GAP-F: model QaModerationEvent ===
// G437 — log audit append-only seluruh aksi moderasi Q&A.
model QaModerationEvent {
  id         String         @id @default(cuid())
  targetType QaReportTarget @map("target_type")
  targetId   String         @map("target_id") // tanpa FK — event bertahan walau target dihapus permanen

  // Nullable: event APPEAL_SUBMITTED dicatat atas nama appellant (user), bukan admin.
  actorAdminId String?    @map("actor_admin_id")
  actorAdmin   AdminUser? @relation("QaEventActor", fields: [actorAdminId], references: [id], onDelete: Restrict)

  action QaEventAction

  reasonCode QaModerationReason? @map("reason_code")
  // Catatan internal — HANYA terlihat admin (tidak pernah diekspos ke API publik).
  note       String?             @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@map("qa_moderation_events")
}

// === GAP-F: model QaDeleteRequest ===
// G435 — hapus permanen konten Q&A butuh approval dua langkah.
model QaDeleteRequest {
  id         String         @id @default(cuid())
  targetType QaReportTarget @map("target_type")
  targetId   String         @map("target_id")

  requestedByAdminId String    @map("requested_by_admin_id")
  requestedBy        AdminUser @relation("QaDeleteRequester", fields: [requestedByAdminId], references: [id], onDelete: Restrict)

  approvedByAdminId String?    @map("approved_by_admin_id")
  approvedBy        AdminUser? @relation("QaDeleteApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)

  status QaDeleteApprovalStatus @default(PENDING)

  reason String? @db.VarChar(1000) // alasan penghapusan (internal)

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("qa_delete_requests")
}

// === GAP-F: PartnerClientStatus ===
enum PartnerClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// === GAP-F: PartnerWebhookDeliveryStatus ===
enum PartnerWebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
  DLQ
}

// === GAP-F: ApiClient ===
model ApiClient {
  id                 String              @id @default(cuid())
  orgName            String              @db.VarChar(120)
  // Opsional: user pemilik akun merchant. Scalar saja (tanpa @relation) supaya
  // fragment tidak perlu menambah field balik di model User.
  ownerUserId        String?
  status             PartnerClientStatus @default(ACTIVE)
  isSandbox          Boolean             @default(false)
  rateLimitPerMinute Int                 @default(100) // G460: configurable per client
  quotaPerDay        Int                 @default(10000) // G461: kuota harian
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  keys             PartnerApiKey[]
  webhookEndpoints PartnerWebhookEndpoint[]
  usage            PartnerApiUsage[]

  @@index([status])
  @@index([ownerUserId])
  @@map("partner_api_clients")
}

// === GAP-F: PartnerApiKey ===
model PartnerApiKey {
  id            String          @id @default(cuid())
  clientId      String
  client        ApiClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyPrefix     String          @db.VarChar(16) // 8 char identifikasi, TANPA hash/secret
  keyHash       String          @db.VarChar(255) // scrypt; plaintext TIDAK PERNAH disimpan
  scopes        String[] // mis. ["orders:read","webhooks:manage"]
  name          String?         @db.VarChar(80)
  expiresAt     DateTime?
  rotatedFromId String?
  rotatedFrom   PartnerApiKey?  @relation("KeyRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     PartnerApiKey[] @relation("KeyRotation")
  validUntil    DateTime? // jendela overlap rotasi (24 jam)
  revokedAt     DateTime?
  revokeReason  String?         @db.VarChar(280)
  lastUsedAt    DateTime?
  createdAt     DateTime        @default(now())

  @@index([clientId])
  @@index([keyPrefix])
  @@map("partner_api_keys")
}

// === GAP-F: PartnerApiUsage ===
model PartnerApiUsage {
  id         String    @id @default(cuid())
  clientId   String
  client     ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  endpoint   String    @db.VarChar(200)
  count      Int       @default(0)
  errorCount Int       @default(0)

  @@unique([clientId, date, endpoint])
  @@index([clientId, date])
  @@map("partner_api_usage")
}

// === GAP-F: PartnerWebhookEndpoint ===
model PartnerWebhookEndpoint {
  id                 String    @id @default(cuid())
  clientId           String
  client             ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url                String    @db.VarChar(500)
  events             String[] // whitelist PARTNER_WEBHOOK_EVENTS
  secretEnc          String    @db.Text // AES-GCM via pola PII; TIDAK PERNAH di-return API
  isActive           Boolean   @default(false)
  verifiedAt         DateTime?
  challengeToken     String?   @db.VarChar(128)
  challengeIssuedAt  DateTime?
  lastDeliveryAt     DateTime?
  lastDeliveryStatus String?   @db.VarChar(16)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deliveries PartnerWebhookDelivery[]

  @@index([clientId])
  @@map("partner_webhook_endpoints")
}

// === GAP-F: PartnerWebhookDelivery ===
model PartnerWebhookDelivery {
  id           String                       @id @default(cuid())
  endpointId   String
  endpoint     PartnerWebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String                       @unique // idempotency key penerima (anti-replay)
  eventType    String                       @db.VarChar(64)
  payload      Json
  attempt      Int                          @default(0)
  status       PartnerWebhookDeliveryStatus @default(PENDING)
  nextRetryAt  DateTime?
  lastError    String?                      @db.VarChar(500) // redacted: tanpa body respons
  responseCode Int?
  createdAt    DateTime                     @default(now())
  completedAt  DateTime?

  @@index([endpointId, status])
  @@index([status, nextRetryAt])
  @@map("partner_webhook_deliveries")
}

// === GAP-F: PartnerAuditLog ===
model PartnerAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String   @db.VarChar(64) // CLIENT_CREATED, KEY_ISSUED, KEY_ROTATED, KEY_REVOKED, ...
  targetType  String?  @db.VarChar(64)
  targetId    String?
  description String   @db.Text
  before      Json?
  after       Json?
  ipAddress   String   @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([targetId, targetType])
  @@index([createdAt])
  @@index([action])
  @@map("partner_audit_logs")
}

// === OPS: AppSetting — operational config manageable via admin panel ===
// Hanya key operasional (token integrasi, flag) yang boleh dikelola.
// Secret disimpan terenkripsi AES-GCM; boot secret & kunci kripto TETAP di .env
// dan tidak masuk registry (lihat settings.registry.ts).
model AppSetting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text // ciphertext bila isSecret=true
  isSecret  Boolean  @default(true)
  label     String?  @db.VarChar(255)
  updatedBy String?  @db.VarChar(128)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Audit trail perubahan setting — hanya menyimpan petunjuk mask, TIDAK PERNAH
// nilai secret utuh.
model AppSettingAudit {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(128)
  action    String   @db.VarChar(32) // SET, TEST
  changedBy String   @db.VarChar(128)
  valueHint String?  @db.VarChar(64) // mis. "••••ab12" — mask, bukan secret
  success   Boolean?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("app_setting_audits")
}

// ============================================================================
// BE-COMMERCE batch (2026-10-01) — model-model commerce baru.
// Semua relasi ke User/Order/UserShowcase memakai soft FK (kolom String tanpa
// back-relation) mengikuti pola Product.sellerId — additive-only, tanpa
// menyentuh model inti yang dipakai tim lain.
// ============================================================================

/// Buku alamat user: label RUMAH/KANTOR/custom, satu default per user.
model Address {
  id     String @id @default(cuid())
  userId String // soft FK users.id

  label         AddressLabel @default(RUMAH)
  customLabel   String?      @db.VarChar(40) // diisi bila label=LAINNYA
  // H2 (SEC-D ronde 2): PII terenkripsi AES-GCM saat rest — kolom TEXT agar
  // muat ciphertext (`v1:salt:iv:tag:data`). DDL via skrip backfill
  // (scripts/backfill-encrypt-addresses.ts), BUKAN migrasi Prisma.
  recipientName String       @db.Text
  phone         String       @db.Text
  addressLine   String       @db.Text
  city          String       @db.Text
  province      String?      @db.Text
  postalCode    String       @db.Text
  isDefault     Boolean      @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@map("addresses")
}

/// Agregat kata kunci pencarian TANPA PII — sumber endpoint trending publik.
model SearchKeyword {
  keyword        String   @id @db.VarChar(80) // lowercase, sudah disanitasi
  searchCount    Int      @default(0)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("search_keywords")
}

/// Slot ketersediaan untuk produk JASA (booking jasa via kalender).
model ServiceSlot {
  id         String @id @default(cuid())
  showcaseId String // soft FK user_showcases.id (produk bertipe JASA)
  sellerId   String // soft FK users.id

  /// Tanggal slot (YYYY-MM-DD, zona WIB) + jam mulai/selesai "HH:mm".
  slotDate    DateTime @db.Date
  startTime   String   @db.VarChar(5)
  endTime     String   @db.VarChar(5)
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  isActive    Boolean  @default(true)
  note        String?  @db.VarChar(200)

  bookings ServiceSlotBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showcaseId, slotDate, isActive])
  @@index([sellerId, slotDate])
  @@map("service_slots")
}

model ServiceSlotBooking {
  id      String      @id @default(cuid())
  slotId  String
  slot    ServiceSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId  String // soft FK users.id (pemesan)
  orderId String? // soft FK orders.id — diisi saat order dibuat dari booking

  status SlotBookingStatus @default(BOOKED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slotId, userId]) // satu user satu booking aktif per slot
  @@index([userId, status])
  @@map("service_slot_bookings")
}

/// SPK digital RINGAN per order: teks kesepakatan + tap setuju kedua pihak.
/// Bukan e-sign korporat — persetujuan tercatat sebagai timestamp per pihak.
model OrderAgreement {
  id      String @id @default(cuid())
  orderId String @unique // soft FK orders.id — satu SPK per order

  text   String          @db.Text
  status AgreementStatus @default(DRAFT)

  sellerAgreedAt DateTime?
  buyerAgreedAt  DateTime?

  createdBy String // soft FK users.id pembuat SPK
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@map("order_agreements")
}

/// Aset pengiriman digital milik seller: file/link/lisensi.
/// Otomatis terlihat buyer SETELAH order berstatus dibayar (lihat
/// DigitalDeliveryService.canBuyerView).
model DigitalAsset {
  id         String @id @default(cuid())
  showcaseId String // soft FK user_showcases.id (produk bertipe DIGITAL)
  sellerId   String // soft FK users.id

  assetType DigitalAssetType
  /// FILE: fileKey privat dari POST /v1/upload/direct. LINK: URL. LICENSE:
  /// kode lisensi/plain text (disimpan apa adanya; bukan secret platform).
  payload   String           @db.Text
  label     String?          @db.VarChar(120)
  sortOrder Int              @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([showcaseId, deletedAt, sortOrder])
  @@map("digital_assets")
}

/// Trip jastip: etalase khusus trip (judul, deadline order, slot, katalog).
model JastipTrip {
  id     String @id @default(cuid())
  hostId String // soft FK users.id (host)

  title         String   @db.VarChar(120)
  description   String?  @db.Text
  orderDeadline DateTime
  slotTotal     Int      @default(0) // 0 = tanpa batas slot
  slotUsed      Int      @default(0)

  status JastipTripStatus @default(DRAFT)

  items        JastipItem[]
  participants JastipParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, status])
  @@index([status, orderDeadline])
  @@map("jastip_trips")
}

/// Katalog/request bebas per trip jastip (harga estimasi, dikunci per buyer).
model JastipItem {
  id     String     @id @default(cuid())
  tripId String
  trip   JastipTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name           String  @db.VarChar(150)
  estimatedPrice BigInt? // sen; estimasi sebelum harga dikunci
  note           String? @db.VarChar(300)

  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("jastip_items")
}

/// Peserta jastip: harga DIKUNCI (barang + fee jastip + ongkir terpisah
/// transparan) baru buyer bayar via escrow order normal (orderId).
model JastipParticipant {
  id      String     @id @default(cuid())
  tripId  String
  trip    JastipTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  buyerId String // soft FK users.id

  itemSummary   String    @db.VarChar(300)
  /// Komponen harga terkunci (sen): transparan & terpisah.
  goodsAmount   BigInt?
  jastipFee     BigInt?
  shippingCost  BigInt?
  totalLocked   BigInt?
  priceLockedAt DateTime?

  orderId String? // soft FK orders.id — escrow order setelah buyer bayar
  status  JastipParticipantStatus @default(JOINED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, buyerId])
  @@unique([orderId]) // satu order escrow hanya boleh ditautkan ke satu peserta
  @@index([buyerId, status])
  @@map("jastip_participants")
}

/// Patungan grup: escrow per peserta, cair bila target tercapai,
/// auto-refund bila gagal. TANPA logika uang baru — modul ini hanya
/// mencatat SYARAT pelepasan; pergerakan dana tetap lewat order escrow
/// normal (participant.orderId) + alur refund/complete yang sudah ada.
model PatunganGroup {
  id     String @id @default(cuid())
  hostId String // soft FK users.id (host)

  title           String       @db.VarChar(120)
  description     String?      @db.Text
  targetAmount    BigInt // sen
  deadlineAt      DateTime
  slotTotal       Int          @default(0) // 0 = tanpa batas
  mode            PatunganMode @default(BAGI_RATA)
  /// Nominal per peserta untuk mode BAGI_RATA (sen).
  perPersonAmount BigInt?

  status        PatunganStatus @default(OPEN)
  /// Diisi saat host inisiasi cair: masa sanggah 24 jam peserta.
  contestEndsAt DateTime?
  releasedAt    DateTime?

  participants PatunganParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, status])
  @@index([status, deadlineAt])
  @@map("patungan_groups")
}

model PatunganParticipant {
  id      String        @id @default(cuid())
  groupId String
  group   PatunganGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String // soft FK users.id

  /// Nominal kontribusi peserta (sen). Mode CUSTOM: bebas (batas wajar di service).
  amount  BigInt
  orderId String? // soft FK orders.id — escrow order peserta
  paidAt  DateTime?

  status PatunganParticipantStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@unique([orderId]) // satu order escrow hanya boleh ditautkan ke satu peserta
  @@index([userId, status])
  @@map("patungan_participants")
}

/// Banner/carousel promo — CRUD admin, endpoint publik banner aktif.
model Banner {
  id String @id @default(cuid())

  title     String    @db.VarChar(120)
  imageUrl  String    @db.VarChar(500)
  linkUrl   String?   @db.VarChar(500)
  position  String    @default("home_top") @db.VarChar(40)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdBy String // soft FK admin_users.id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position, sortOrder])
  @@map("banners")
}

// === AUDIT 2026-10-03: model baru ===

// BFE-117 / FAL-009: like/dislike komentar showcase — persisten per user,
// toggle idempoten. value: 1 = suka, -1 = tidak suka.
model ShowcaseCommentReaction {
  id        String          @id @default(cuid())
  commentId String
  comment   ShowcaseComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // 1 | -1
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("showcase_comment_reactions")
}

// SEC-104: intent settlement sengketa no-wallet yang durable. Dibuat di DALAM
// tx putusan (status PENDING), diklaim post-commit, disapu cron bila belum DONE.
// Mencegah: sengketa RESOLVED tapi uang tidak bergerak tanpa jalur retry.
model DisputeSettlementIntent {
  id             String   @id @default(cuid())
  disputeId      String   @unique
  dispute        Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  status         String   @default("PENDING") @db.VarChar(20) // PENDING | CLAIMED | DONE | FAILED | ESCALATED (SYS-B-302)
  buyerAmountSen BigInt   @default(0)
  sellerAmountSen BigInt  @default(0)
  attemptCount   Int      @default(0)
  lastError      String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  claimedAt      DateTime?
  doneAt         DateTime?

  @@index([status, updatedAt])
  @@map("dispute_settlement_intents")
}

// SEC-503: token step-up re-auth admin — single-use, TTL pendek, terikat
// aksi+target. Disimpan hash-nya saja; yang dikirim ke admin adalah token mentah.
// adminId disimpan sebagai String polos (tanpa FK) mengikuti konvensi repo.
model AdminStepUpToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  action    String    @db.VarChar(120)
  targetId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, createdAt])
  @@map("admin_step_up_tokens")
}

// SEC-501/502/601/602 + BAD-001: dual control untuk aksi sensitif admin.
// Aksi membuat record PENDING (proposedBy + step-up); admin KEDUA (!= proposer)
// menyetujui dengan step-up-nya sendiri, baru dieksekusi.
model AdminActionApproval {
  id             String    @id @default(cuid())
  actionType     String    @db.VarChar(120)
  targetId       String?
  payload        Json
  amountSen      BigInt?
  idempotencyKey String    @unique
  proposedBy     String // AdminUser.id, tanpa FK
  proposedAt     DateTime  @default(now())
  status         String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | EXECUTED | REJECTED | EXPIRED
  decidedBy      String?
  decidedAt      DateTime?
  executedAt     DateTime?
  expiresAt      DateTime
  rejectReason   String?   @db.Text

  @@index([status, expiresAt])
  @@index([proposedBy, proposedAt])
  @@map("admin_action_approvals")
}

// ── Karir karir.kahade.id (Fase F1, 2026-10-03) ─────────────────────────────
// Konvensi tabel baru: kolom camelCase TANPA @map; nama tabel snake_case via @@map.
// Status pipeline lamaran
enum JobApplicationStatus {
  BARU // baru masuk, belum dibaca
  DIREVIEW // sedang ditinjau
  WAWANCARA // lolos ke tahap wawancara
  DITERIMA // diterima (terminal — arsip HR)
  DITOLAK // ditolak (terminal — kena retensi 90 hari)
}

// Lowongan pekerjaan (dikelola admin SUPER_ADMIN)
model JobPosting {
  id          String    @id @default(cuid())
  slug        String    @unique @db.VarChar(128) // "co-founder-coo" — untuk URL
  title       String    @db.VarChar(200) // "Co-Founder / COO"
  location    String    @db.VarChar(128) // "Remote" | "Jakarta"
  type        String    @db.VarChar(64) // "Penuh waktu" | "Paruh waktu" | "Kontrak"
  equity      String    @db.VarChar(128) // "15% saham" — WAJIB diisi, tampil eksplisit
  summary     String    @db.Text // 1-2 kalimat untuk kartu
  description String    @db.Text // markdown: tanggung jawab, kualifikasi
  requirements Json     @default("[]") // string[]
  isActive    Boolean   @default(true)
  publishedAt DateTime?
  closedAt    DateTime?
  sortOrder   Int       @default(0)
  createdBy   String? // admin id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications JobApplication[]

  @@index([isActive, sortOrder])
  @@map("job_postings")
}

// Lamaran pelamar (PII — HANYA via endpoint admin SUPER_ADMIN).
// SENGAJA tanpa @@unique([postingId, email]): pelamar DITOLAK boleh melamar
// lagi posisi yang sama. Duplikat aktif dicegah di service (409 ALREADY_APPLIED
// bila ada lamaran existing dengan status selain DITOLAK).
model JobApplication {
  id                String               @id @default(cuid())
  postingId         String
  posting           JobPosting           @relation(fields: [postingId], references: [id], onDelete: Cascade)
  fullName          String               @db.VarChar(200)
  email             String               @db.VarChar(255)
  phone             String               @db.VarChar(32)
  coverNote         String?              @db.Text
  cvFileKey         String               @db.VarChar(512) // key privat career-cvs/
  portfolioUrl      String?              @db.VarChar(512)
  status            JobApplicationStatus @default(BARU)
  internalNote      String?              @db.Text // catatan admin, TIDAK tampil ke publik
  reviewedBy        String? // admin id terakhir
  reviewedAt        DateTime?
  deletionTokenHash String               @db.VarChar(128) // hash bcrypt token hapus-mandiri
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  history JobApplicationStatusHistory[]

  @@index([postingId, status])
  @@index([status, updatedAt]) // untuk cron retensi 90 hari
  @@map("job_applications")
}

// Audit trail perubahan status lamaran
model JobApplicationStatusHistory {
  id            String               @id @default(cuid())
  applicationId String
  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    JobApplicationStatus?
  toStatus      JobApplicationStatus
  changedBy     String? // admin id; null = sistem (cron)
  note          String?              @db.Text
  createdAt     DateTime             @default(now())

  @@index([applicationId])
  @@map("job_application_status_history")
}
