  after       Json?

  ipAddress   String
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([adminId])
  @@index([targetId, targetType])
  @@index([createdAt])
  @@index([action])   // filter audit logs by action type
  @@map("admin_audit_logs")
}

