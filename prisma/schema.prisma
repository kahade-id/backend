model ShowcaseImage {
  id         String       @id @default(cuid())
  showcaseId String
  showcase   UserShowcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  /// URL publik yang siap dipakai client (R2 public bucket).
