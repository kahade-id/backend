  updatedBy   String?             // Admin ID (soft FK ke admin_users.id)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

model WebhookLog {
  id            String   @id @default(cuid())
  source        String   // 'MIDTRANS', 'MIDTRANS_IRIS'
  event         String
  payload       Json
  headers       Json?
  transactionId String?
  // Stable key: provider + transaction id + status. Nullable for legacy rows.
  eventKey      String?  @unique

  isProcessed Boolean  @default(false)
  processedAt DateTime?
  errorMessage String?
  retryCount       Int      @default(0)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  deadLetteredAt  DateTime?

  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([source, isProcessed])
  @@index([source, event])
  @@index([createdAt])
  @@index([transactionId])
  @@index([source, isProcessed, nextRetryAt])
  @@index([deadLetteredAt])
  @@map("webhook_logs")
}

model AuditLog {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  // dengan AdminAuditLog.action yang sudah menggunakan AuditAction enum.
  action      UserAuditAction
  entityType  String
  entityId    String
  description String      @db.Text
  before      Json?
  after       Json?

  ipAddress   String?
  userAgent   String?
  requestId   String?     // X-Request-ID header

  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([entityId, entityType])
  @@index([createdAt])
  @@index([action])   // filter by action type
  @@index([requestId]) // request tracing dan debugging via X-Request-ID
  @@map("audit_logs")
}

