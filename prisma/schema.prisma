  chatMessages             ChatMessage[]
  chatRoomsAsInitiator     ChatRoom[]              @relation("ChatRoomInitiator")
  chatRoomsAsCounterpart   ChatRoom[]              @relation("ChatRoomCounterpart")
  chatRoomMemberships      ChatRoomMember[]
