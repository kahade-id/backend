  relatedArticleId String?
  relatedArticle   FaqItem?              @relation(fields: [relatedArticleId], references: [id], onDelete: SetNull)
  status           SupportTicketStatus   @default(OPEN)
  attachments      Json                  @default("[]")
  rating           Int?
