  totalOrdersAsSeller   Int      @default(0) // Denormalized counter — updated by OrderStateService
  totalOrdersCancelled  Int      @default(0) // Check constraint via migration (>= 0)
  totalOrdersDisputed   Int      @default(0) // Check constraint via migration (>= 0)
