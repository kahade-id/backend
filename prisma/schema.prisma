// Feedback pengguna (G-001). Bisa dikirim guest (userId null) — auth opsional.
// Dipakai halaman feedback aplikasi; bukan tiket support (tidak ada balasan).
model Feedback {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  category String  @db.VarChar(100)
  message  String  @db.Text
  contact  String? @db.VarChar(320)
  rating   Int?
  platform String  @default("app") @db.VarChar(32)

  createdAt DateTime @default(now())

  // === GAP-C: workflow peninjauan feedback (G151–G175), kolom aditif ===
  status         FeedbackStatus       @default(NEW)
  assigneeId     String?
  tags           String[]             @default([])
  impactLabel    String?              @db.VarChar(50)
  contactConsent Boolean              @default(false)
  appVersion     String?              @db.VarChar(32)
  slaDueAt       DateTime?
  riskFlag       FeedbackRisk         @default(NONE)
  closedReason   FeedbackCloseReason?
  closedAt       DateTime?
  redactedAt     DateTime?
  updatedAt      DateTime             @updatedAt

  assignments   FeedbackAssignment[]
  internalNotes FeedbackInternalNote[]
  replies       FeedbackReply[]
  audit         FeedbackAudit[]

  @@index([userId])
  @@index([createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
  @@index([assigneeId])
  @@index([riskFlag])
  @@map("feedback")
}

model DisputeMessage {
  id          String     @id @default(cuid())
  disputeId   String
  dispute     Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?      @relation("DisputeMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  adminId     String?
  admin       AdminUser? @relation("DisputeMessageAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  message     String     @db.Text
  attachments Json       @default("[]")

  createdAt DateTime @default(now())

  @@index([disputeId])
  @@index([disputeId, createdAt])
  @@index([adminId])
  @@map("dispute_messages")
}

/// Section 3 — Showcase berubah dari "etalase statis" menjadi konten sosial:
/// punya banyak gambar, kategori, visibilitas, dan counter like/komentar/view
/// yang didenormalisasi agar feed discover tidak perlu COUNT(*) per baris.
model UserShowcase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String             @db.VarChar(100)
  description     String?            @db.VarChar(500)
  /// Deskripsi HTML khusus subscriber Kahade+ (Benefit 7 — Custom Etalase).
  /// Backend menyimpan apa adanya (dibatasi panjang); sanitasi dilakukan
  /// saat render di frontend.
  descriptionHtml String?            @db.Text
  /// Kategori bebas-terkendali untuk filter feed discover (mis. "ilustrasi",
  /// "jasa video"). Nullable: item lama tanpa kategori tetap muncul di feed.
  category        String?            @db.VarChar(60)
  /// PRIVATE menyembunyikan item dari feed discover DAN dari profil publik;
  /// hanya pemilik (dan admin) yang bisa melihatnya.
  visibility      ShowcaseVisibility @default(PUBLIC)
  priceMin        BigInt?
  priceMax        BigInt?
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)

  /// Batch 19 TIM A (item 6): kondisi barang. Nullable — item lama tanpa
  /// kondisi tetap muncul bila filter ?condition= tidak dipakai.
  condition ShowcaseCondition?

  /// Counter denormalisasi. Selalu di-update lewat Prisma atomic increment
  /// ({ increment } / { decrement }) di dalam transaksi yang sama dengan
  /// mutasi barisnya — pola TransactionTemplatesService.recordUsage.
  likeCount    Int       @default(0)
  commentCount Int       @default(0)
  viewCount    Int       @default(0)
  /// Batch 19 TIM A (item 3): jumlah user yang menyimpan (save) item ini.
  saveCount    Int       @default(0)
  /// Jumlah kali deep link share dibuka/dibagikan. Di-increment atomik saat
  /// GET /v1/showcase/:id/share (pola atomic counter seperti likeCount).
  shareCount   Int       @default(0)
  /// View pada hari kalender berjalan (zona Asia/Jakarta) — sumber ranking
  /// sort feed "popular" (populer harian). Di-update atomik di recordView:
  /// naik bila bucket hari masih sama, reset ke 1 bila hari berganti (satu
  /// statement CASE — tanpa cron). Bukan bagian financial core.
  hotViews     Int       @default(0)
  /// Tanggal (WIB) terakhir hotViews dihitung. Null = belum pernah dihitung.
  hotViewDate  DateTime? @db.Date

  /// BE-COMMERCE (2026-10-01): tipe produk JASA/FISIK/DIGITAL/LAINNYA.
  /// Nullable: item lama tanpa tipe tetap tampil.
  productType         ProductType?
  /// Jadwal publish etalase: item dengan isActive=false + scheduledAt di masa
  /// depan akan dipublish otomatis oleh cron ScheduledShowcasePublishService.
  scheduledAt         DateTime?
  /// Harga coret (dalam sen, rupiah*100). Validasi: harus > harga jual bila diisi.
  originalPrice       BigInt?
  /// Tenggat pengerjaan dalam hari — WAJIB bila productType=JASA.
  serviceDeadlineDays Int?
  /// Info/payload pengiriman digital untuk productType=DIGITAL (mis. instruksi
  /// redeem, format file). File/link/lisensi aktual dikelola DigitalAsset.
  digitalDeliveryInfo String?      @db.Text
  /// Hit klik produk (mis. tap tombol beli dari etalase). Atomic increment.
  clickCount          Int          @default(0)
  /// Hit pembelian: dihitung on-read dari order (lihat ProductCommerceService),
  /// kolom ini cadangan denormalisasi bila dibutuhkan kelak.
  purchaseCount       Int          @default(0)

  images         ShowcaseImage[]
  likes          ShowcaseLike[]
  saves          ShowcaseSave[]
  highlightItems UserHighlightItem[]
  comments       ShowcaseComment[]
  reports        ShowcaseReport[]
  dailyStats     ShowcaseDailyStat[]
  // SH-B-011: back-relation asal etalase (nullable di sisi Order/OrderLink).
  orders         Order[]             @relation("OrderShowcase")
  orderLinks     OrderLink[]         @relation("OrderLinkShowcase")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft delete: item dihapus user masuk ke sini. Bisa dipulihkan dalam
  /// 30 hari; setelah itu hard delete otomatis via cron.
  deletedAt DateTime?

  @@index([userId, isActive, sortOrder])
  // Feed discover: sort "latest" (createdAt), "popular" harian (hotViews),
  // dan "foryou" (skor dihitung di aplikasi). Kolom id ikut di index karena
  // dipakai sebagai tiebreak cursor pagination.
  @@index([visibility, isActive, createdAt, id])
  @@index([visibility, isActive, likeCount, id])
  @@index([visibility, isActive, hotViews, id])
  @@index([category])
  @@map("user_showcases")
}

/// Agregat harian view showcase per hari kalender (zona Asia/Jakarta).
/// Ditulis best-effort (upsert) oleh ShowcaseService.recordView — metrik
/// non-kritis, kegagalan tulis tidak menggagalkan pencatatan view.
/// Dipakai sebagai riwayat popularitas (analitik/admin, mis. "populer minggu
/// ini" di masa depan); ranking feed "popular" harian memakai kolom
/// denormalisasi UserShowcase.hotViews agar bisa diurut + keyset-pagination
/// langsung di query feed tanpa join agregat. Bukan bagian financial core.
model ShowcaseDailyStat {
  id         String       @id @default(cuid())
  showcaseId String
  showcase   UserShowcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  /// Hari kalender (WIB). Satu baris per (showcase, hari).
  date  DateTime @db.Date
  views Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showcaseId, date])
  @@index([date])
  @@map("showcase_daily_stats")
}

/// Highlight etalase (batch 19 TIM A, item 4): koleksi pilihan berisi
/// produk-produk etalase milik user, dengan cover opsional.
model UserHighlight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String  @db.VarChar(80)
  /// Id ShowcaseImage milik salah satu etalase milik user (divalidasi di
  /// service; nullable = pakai media pertama produk pertama sebagai cover).
  /// SENGAJA tanpa FK ke showcase_images: media bisa dihapus user kapan saja,
  /// dan cover yang menunjuk media terhapus cukup diabaikan (fallback cover).
  coverMediaId String?
  sortOrder    Int     @default(0)

  items UserHighlightItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, sortOrder])
  @@map("user_highlights")
}

