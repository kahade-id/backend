  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  sessions                 UserSession[]
  devices                  UserDevice[]
  twoFactorAuth            TwoFactorAuth?
  otpCodes                 OtpCode[]
  kycRequests              KycRequest[]
  // Verifikasi badan usaha (badge "Business Verified") — domain terpisah dari KYC
  businessVerifications    BusinessVerification[]
  bankAccounts             BankAccount[]
  wallet                   Wallet?
  // Misi tanpa-wallet (BI-safe): disbursement escrow langsung ke bank seller.
  escrowDisbursements      EscrowDisbursement[]    @relation("EscrowDisbursementSeller")
  ordersAsBuyer            Order[]                 @relation("BuyerOrders")
