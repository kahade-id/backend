generator client {
  provider = "prisma-client-js"
  // fullTextSearch:
  //   karena mendaftarkan GA feature di sini menyebabkan warning/error di Prisma 5+.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

