  voucherUsages            VoucherUsage[]
  referralCode             ReferralCode?
  referralUsed             ReferralRelation?       @relation("RefereeUser") // fix typo: ReferreeUser → RefereeUser
  referralsGiven           ReferralRelation[]      @relation("ReferrerUser")
