// === GAP-B: privacy/export ===
// Kontrol privasi granular + persetujuan (consent) berversi + riwayat ekspor
// data (G076–G100). Append-only: model & enum baru, tidak mengubah yang ada.
//
// - PrivacySetting: satu baris per user (userId unique); default kolom
//   selaras dengan DEFAULT_PRIVACY_SETTING di
//   src/modules/users/privacy-profile.util.ts.
// - ConsentRecord: append-only per pemberian/penarikan; satu baris "terbuka"
//   (revokedAt NULL) per (userId, type) menandakan consent aktif.
//   policyVersion + policyTextHash = bukti teks kebijakan yang disetujui.
//   IP mentah TIDAK disimpan — hanya hash SHA-256 (ipHash).
// - DataExportRequest: jejak permintaan ekspor; artifactKey menunjuk ke file
//   di storage privat. URL signed TIDAK disimpan mentah (dibuat on-demand
//   saat unduh, TTL singkat) — lihat G100.
// Migrasi: prisma/migrations/20260927020000_gap_b_privacy_export (SQL manual,
// idempoten IF NOT EXISTS).

enum PrivacyListVisibility {
  EVERYONE
  FOLLOWERS
  ONLY_ME
}

enum QaCommentPolicy {
  EVERYONE
  FOLLOWERS
  DISABLED
}

// Batch 43 BE-CHAT: kebijakan siapa yang boleh membuka DM ke user ini.
// EVERYONE = siapa pun; FOLLOWING = hanya yang di-follow user ini;
// NONE = tidak ada (DM baru ditolak; percakapan lama tetap bisa dipakai).
enum DmPolicy {
  EVERYONE
  FOLLOWING
  NONE
}

enum ConsentType {
  MARKETING_PUSH
  MARKETING_EMAIL
  MARKETING_WHATSAPP
  TRANSACTIONAL
}

enum DataExportStatus {
  PENDING
  READY
  EXPIRED
  FAILED
}

enum DataExportFormat {
  JSON
  CSV
}

model PrivacySetting {
  id                        String                @id @default(cuid())
  userId                    String                @unique
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // G076: visibilitas field identitas (berlaku untuk viewer != owner; opt-in).
  showEmail                 Boolean               @default(false)
  showPhone                 Boolean               @default(false)
  showDob                   Boolean               @default(false)
  showGender                Boolean               @default(false)
  // G077: siapa yang dapat melihat daftar follower/following.
  showFollowerList          PrivacyListVisibility @default(EVERYONE)
  showFollowingList         PrivacyListVisibility @default(EVERYONE)
  // G078: visibilitas default karya etalase baru.
  showcaseDefaultVisibility ShowcaseVisibility    @default(PUBLIC)
  // G079–G080: kebijakan komentar/tanya jawab profil.
  qaCommentPolicy           QaCommentPolicy       @default(EVERYONE)
  qaAnswerModeration        Boolean               @default(false)
  // G081: tampilkan ulasan/rating di profil publik.
  showReviews               Boolean               @default(true)
  // G082: kunci statistik yang disembunyikan dari pengunjung publik.
  hiddenStats               String[]              @default([])
  // G083: izinkan profil diindeks mesin pencari.
  searchEngineIndex         Boolean               @default(true)
  // Batch 43 BE-CHAT: sembunyikan centang baca (read receipt) dari lawan bicara.
  hideReadReceipts          Boolean               @default(false)
  // Batch 43 BE-CHAT: kebijakan DM (ditegakkan saat pembuatan DM baru).
  dmPolicy                  DmPolicy              @default(EVERYONE)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@map("privacy_settings")
}

model ConsentRecord {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ConsentType
  // G085: versi + hash teks kebijakan saat consent diberikan/ditarik.
  policyVersion  String
  policyTextHash String      @db.VarChar(64)
  // Kanal pemberian: push/email/whatsapp/in-app (opsional).
  channel        String?     @db.VarChar(32)
  grantedAt      DateTime    @default(now())
  revokedAt      DateTime?
  // Hash SHA-256 IP pemberi (bukan IP mentah).
  ipHash         String?     @db.VarChar(64)

  @@index([userId])
  @@index([userId, type, grantedAt])
  @@map("consent_records")
}

model DataExportRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        DataExportStatus @default(PENDING)
  format        DataExportFormat @default(JSON)
  // Kunci artefak di storage privat (bukan URL signed mentah).
  artifactKey   String?
  requestedAt   DateTime         @default(now())
  readyAt       DateTime?
  expiresAt     DateTime?
  // G100: jejak setiap akses unduhan.
  downloadedAt  DateTime?
  downloadCount Int              @default(0)
  failureReason String?

  @@index([userId, requestedAt])
  @@map("data_export_requests")
}

