  // User tanpa order COMPLETED dalam N hari terakhir; NULL berarti tidak difilter.
  targetDormantDays  Int?
  // Jika true, hanya user yang belum pernah COMPLETED order.
  targetNewUserOnly  Boolean         @default(false)
  // Kode promo unik untuk campaign subscription discount.
