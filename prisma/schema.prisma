// ============================================================
// PROFILE Q&A
// ============================================================

model ProfileQuestion {
  id         String @id @default(cuid())
  askerId    String
  asker      User   @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("QuestionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  question   String    @db.VarChar(500)
  answer     String?   @db.VarChar(1000)
  answeredAt DateTime?

  isPublic     Boolean              @default(true)
  isHidden     Boolean              @default(false)
  /// Section 4: `isHidden` polos digantikan alasan kategoris. Menyembunyikan
  /// pertanyaan tanpa mengisi alasan ditolak di level service dan di level DB
  /// (constraint profile_question_hidden_fields_consistent).
  hiddenReason ContentHiddenReason?
  hiddenAt     DateTime?
  hiddenBy     String?              @db.VarChar(100)

  /// Section 4: jumlah upvote. Denormalisasi + atomic increment (pola
  /// TransactionTemplatesService.recordUsage) supaya urutan "terpopuler" tidak
  /// perlu COUNT(*) per baris.
  upvoteCount    Int       @default(0)
  /// Section 4: penanda pengingat 48 jam sudah dikirim. Sekali per pertanyaan —
  /// job reminder mengklaim baris ini dengan updateMany bersyarat sehingga dua
  /// instance yang balapan tidak mengirim dua notifikasi.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments ProfileQuestionComment[]
  upvotes  ProfileQuestionUpvote[]

  @@index([receiverId])
  @@index([askerId])
  @@index([receiverId, isPublic, isHidden])
  // Job reminder 48 jam: scan pertanyaan belum dijawab yang belum diingatkan.
  @@index([answeredAt, reminderSentAt, createdAt])
  // Urutan "terpopuler" di Q&A publik.
  @@index([receiverId, isPublic, isHidden, upvoteCount])
  @@map("profile_questions")
}

/// Section 4 — upvote pertanyaan profil. Unique (userId, questionId) ditegakkan
/// di DB agar dua request balapan tidak menghasilkan upvote ganda / counter
/// melenceng.
model ProfileQuestionUpvote {
  id         String          @id @default(cuid())
  questionId String
  question   ProfileQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId, createdAt, id])
  @@index([userId])
  @@map("profile_question_upvotes")
}

model ProfileQuestionComment {
  id         String                   @id @default(cuid())
  questionId String
  question   ProfileQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User                     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     ProfileQuestionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ProfileQuestionComment[] @relation("CommentReplies")

  content      String               @db.VarChar(1000)
  isHidden     Boolean              @default(false)
  /// Section 4: alasan moderasi kategoris, sama seperti ProfileQuestion dan
  /// ShowcaseComment (ContentHiddenReason).
  hiddenReason ContentHiddenReason?
  hiddenAt     DateTime?
  hiddenBy     String?              @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
  @@index([authorId])
  @@index([parentId])
  @@map("profile_question_comments")
}

